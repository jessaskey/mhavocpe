3335+  9736             ;********************************************
3336+  9736             ;* Checks one line up and one stamp left    *
3337+  9736             ;* for possible head and or body collision  *
3338+  9736             ;*                                          *
3339+  9736             ;* Inputs: temp3 = X position (word)        *
3340+  9736             ;*         temp4 = Y position (word)        *
3341+  9736             ;*                                          *
3342+  9736             ;* Output: trcol = 80 if no left motion     *
3343+  9736             ;*                 allowed                  *
3344+  9736             ;*                                          *
3345+  9736             ;* Uses:   temp5, 2 bytes stack             *
3346+  9736             ;********************************************   
3347+  9736 E6 12       lthdck  inc temp4+1     ;One line up
3348+  9738 C6 10               dec temp3+1     ;One stamp left
3349+  973A 20 75 93            jsr sttype      ;A = stamp to the left
3350+  973D E6 10               inc temp3+1     ;restore
3351+  973F C9 01               cmp #01
3352+  9741                     \ .push  *, 0 \ BNE  * 		
3352+  9741             
