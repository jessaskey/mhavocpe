0313+  C9F9             ;*************************************************************
0314+  C9F9                 .sbttl "Get Scaled Speed"
0315+  C9F9             ;*************************************************************
0316+  C9F9             ;* The routine calculates the speed an object will move on   *
0317+  C9F9             ;* the screen based on it's Y position.(starspeed,etc)       *
0318+  C9F9             ;*                                                           *
0319+  C9F9             ;* Inputs:  A = Y position MSB                               *
0320+  C9F9             ;*          Y = Y Position LSB                   *
0321+  C9F9             ;*   (spcspd) = Speed Factor, larger numbers are slower      *
0322+  C9F9             ;*      carry = set for up screen                            *
0323+  C9F9             ;*                                                           *
0324+  C9F9             ;* Output:  A & temp1  = speed amount LSB                    *
0325+  C9F9             ;*          A & temp+1 = speed amoutn MSB                  *
0326+  C9F9             ;*                                                           *
0327+  C9F9             ;* Uses:    A, Y, temp1, 2 bytes stack                       *
0328+  C9F9             ;*                                                           *
0329+  C9F9             ;* Note: Entry at gss2 assumes:                              *
0330+  C9F9             ;*      1) LSB already stored in temp1                   *
0331+  C9F9             ;*      2) Input Y = speed factor                        *
0332+  C9F9             ;*                                                           *
0333+  C9F9             ;* Note: Entry at gss1 is for Star Motion. The Amount of     *
0334+  C9F9             ;*       offset is added so stars move at different speeds   *
0335+  C9F9             ;************************************************************* 
0336+  C9F9 84 0B       gss1    sty temp1
0337+  C9FB 08                  php 
0338+  C9FC 48                  pha 
0339+  C9FD BD 52 09            lda strflg,X        ;Save A and Carry
0340+  CA00 29 03               and #03
0341+  CA02 49 FF               eor #$FF            ;Negate this
0342+  CA04 38                  sec 
0343+  CA05 6D 66 09            adc spcspd
0344+  CA08 A8                  tay 
0345+  CA09 68                  pla 
0346+  CA0A 4C 13 CA            jmp gss3
0347+  CA0D 84 0B       gss     sty temp1           ;Save for later
0348+  CA0F AC 66 09            ldy spcspd
0349+  CA12 08          gss2    php             	;Save entry carry
0350+  CA13 20 D3 A5    gss3    jsr mror            ;Get scaled speed
