0411+  F189 85 0F               sta temp3           	;Seed starts here
0412+  F18B                     
0413+  F18B A9 80               lda # ((program&$ff00)/$100)    ;Do main page program now
0414+  F18D 85 0C               sta temp1+1
0415+  F18F A2 40               ldx #64d                ;Lots of pages here
0416+  F191 20 35 F1            jsr ?dosum
0417+  F194 A9 C0               lda # ((program2&$ff00)/$100) 	;Second ROM  
0418+  F196 85 0C               sta temp1+1
0419+  F198 A2 40               ldx #64d
0420+  F19A 20 35 F1            jsr ?dosum              ;Do C000-FFFF
0421+  F19D A9 00               lda #00
0422+  F19F 85 11               sta temp4               ;Now do programming paging
