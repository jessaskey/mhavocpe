3304+  971D             ;********************************************
3305+  971D                 .sbttl "Right Edge Check"
3306+  971D             ;********************************************
3307+  971D             ;* Checks one line up and one stamp right   *
3308+  971D             ;* for possible head and or body collision  *
3309+  971D             ;*                                          *
3310+  971D             ;* Inputs: temp3 = X position (word)        *
3311+  971D             ;*         temp4 = Y position (word)        *
3312+  971D             ;*                                          *
3313+  971D             ;* Output: trcol = 80 if no right motion    *
3314+  971D             ;*                 allowed                  *
3315+  971D             ;*                                          *
3316+  971D             ;* Uses:   temp5, 2 bytes stack             *
3317+  971D             ;********************************************   
3318+  971D E6 12       rthdck  inc temp4+1     ;One line up
3319+  971F E6 10               inc temp3+1     ;One stamp right
3320+  9721 20 75 93            jsr sttype      ;A = What stamp is to the right??
3321+  9724 C6 10               dec temp3+1     ;Restore
3322+  9726 C9 04               cmp #04
3323+  9728                     \ .push  *, 0 \ BCS  *                 ;0,1,2,3 collide ( 0 is don't care)
3323+  9728             
3323+  9728 B0 FE       
3324+  972A A5 0F                   lda temp3
3325+  972C C9 DE                   cmp #lftwal+$3e     ;Might be touching next wall
3326+  972E                         \ .push  *, 0 \ BCC  *                 ;yep
3326+  972E             
3326+  972E 90 FE       
