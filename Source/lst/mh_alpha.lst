0017+  D71A 10 10               bpl ?psc5
0018+  D71C                     ;Dying here
0019+  D71C 20 50 DB            jsr ?clrjump        ;Clear Jump Status
0020+  D71F EE 98 03            inc manstat         ;Continue to Kill Him
0021+  D722 D0 08               bne ?psc5           ;Just go to scont if not yet dead
0022+  D724 AD 82 08    ?psc80  lda scrbuf
0023+  D727 0D 83 08            ora scrbuf+1        ;Wait till all score is added in
