0002+  A5E2 502E
0003+  A5E4             ;********************************************************
0004+  A5E4                 .title "TWShip - Ship Control"
0005+  A5E4                 .sbttl "Game States"
0006+  A5E4             ;********************************************************
0007+  A5E4             ;* Game States and the numbers that go with them..      
0008+  A5E4             ;*                                                      
0009+  A5E4             ;*     STATE                   MZGAME  GAMEST  X FOR    
0010+  A5E4             ;*       #                     VALUE   BIT 7   TARGSHIP 
0011+  A5E4             ;*------------------------------------------------------
0012+  A5E4             ;*                                                      
0013+  A5E4             ;* 1). In Tube                 40         0    0/2      
0014+  A5E4             ;* 2). Tact Dsp, Space Trans.  20         0     1       
0015+  A5E4             ;* 3). Space Play              00         0     2       
0016+  A5E4             ;* 4). Left/Right Move(trans)  10         0    3/4     
0017+  A5E4             ;* 5). Upwards trans to center 08         0     5      
0018+  A5E4             ;* 6). Landing on Maze         04         0     2       
0019+  A5E4             ;* 7). Zoom in after land      02         0     6       
0020+  A5E4             ;* 8). Game Play in Maze       80        0/1   ***      
0021+  A5E4             ;* 9). Zoom out after Exit     02         1     7       
0022+  A5E4             ;*10). Take off from Maze      04         1     2       
0023+  A5E4             ;*11). Blow Maze Sequence      01         1    9/10     
0024+  A5E4             ;*                                                      
0025+  A5E4             ;* Note:    Gamest bit 7 represents a succesful exit    
0026+  A5E4             ;*          from the maze. X is the index to the        
0027+  A5E4             ;*          motion/speed used by that section of game   
0028+  A5E4             ;*          play.                                       
0029+  A5E4             ;* Note:    If tact is minus, then tactile scanner mode 
0030+  A5E4             ;*          is on; and X is always set to 8 until that  
0031+  A5E4             ;*          mode ends. No change of gamest will take    
0032+  A5E4             ;*          place in the tact routine.                  
0033+  A5E4             ;********************************************************
0034+  A5E4             __numtrg 		= 13d
0035+  A5E4             __curtrg		= 0d
0036+  A5E4             __tmptrg		= 0
0037+  A5E4             
