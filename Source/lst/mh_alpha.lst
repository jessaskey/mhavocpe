0004+  BB02                 .title "TWMAP - Map Stuff"
0005+  BB02             ;***********************************************
0006+  BB02             
0007+  BB02             ;*******************************************************
0008+  BB02             ;* Maze Size Definitions
0009+  BB02             ;* The RAM Buffer (mazebuf) sits at 0900-09FF which is
0010+  BB02             ;* 256 bytes. The max vert of each width is shown below
0011+  BB02             ;* total bytes can't exceed 256 bytes;
0012+  BB02             ;*
0013+  BB02             ;* Width:   DefinedHeight:   MaxHeight:   Maze:
0014+  BB02             ;*  $10        $07             $10          0
0015+  BB02             ;*  $13        $0B             $0D          3
0016+  BB02             ;*  $15        $08             $0C          1
0017+  BB02             ;*  $15        $09             $0C          2
0018+  BB02             ;*    
0019+  BB02             ;* Vertical Length Counters             
0020+  BB02             ;* Number of 'drawn' lines in each maze 
0021+  BB02             
0022+  BB02 07          mazdep  .db (m0ulast-m0u1)/(m0u2-m0u1)
0023+  BB03 08          		.db (m1ulast-m1u1)/(m1u2-m1u1)
0024+  BB04 09          		.db (m2ulast-m2u1)/(m2u2-m2u1)
0025+  BB05 0B          		.db (m3ulast-m3u1)/(m3u2-m3u1)
0026+  BB06             
0027+  BB06             ;* Horizontal Length of each maze             
0028+  BB06 10 15 15 13 mazlen  .db m0u2-m0u1,m1u2-m1u1,m2u2-m2u1,m3u2-m3u1
0029+  BB0A             
0030+  BB0A             ;**************************************************
0031+  BB0A                 .sbttl "Bit patterns for each stamp"
0032+  BB0A             ;**************************************************
0033+  BB0A             ;* These patterns are used to draw the little map 
0034+  BB0A             ;* at the top of the screen. For each stamp there 
0035+  BB0A             ;* is a byte which represents a bit rep of that   
0036+  BB0A             ;* stamp. For example.. Stamp 1 -- H line will be 
0037+  BB0A             ;* $c0 (only top two bits are used) for the horiz 
0038+  BB0A             ;* rep and will be 0 for vert.                    
0039+  BB0A             ;**************************************************
0040+  BB0A             ;There is no stamp 0, so it is blank
0041+  BB0A             ;                 1   2   3   4   5   6   7
0042+  BB0A 00C080804040mapbits .byte $00,$C0,$80,$80,$40,$40,$00,$00
0042+  BB10 0000
0043+  BB12 000040808040mapvbt  .byte $00,$00,$40,$80,$80,$40,$C0,$00
0043+  BB18 C000
0044+  BB1A             
0045+  BB1A             ;*************************************************
0046+  BB1A                 .sbttl "Place All Objects"
0047+  BB1A             ;*************************************************
