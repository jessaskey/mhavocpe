0003+  EE58             ;*********************************************
0004+  EE58                 .title "Message Routine"
0005+  EE58             ;*******************************************************
0006+  EE58             ;* Will output specified message to specified location 
0007+  EE58             ;* on screen.                                          
0008+  EE58             ;*      
0009+  EE58             ;*  Inputs: Y = message # 
0010+  EE58             ;*
0011+  EE58             ;* mesg   - Normal Message routine, uses all defaults                       
0012+  EE58             ;*  Inputs: X = message # 
0013+  EE58             ;*
0014+  EE58             ;* mesgv  - Override Y Position
0015+  EE58             ;*  Inputs: X = message # 
0016+  EE58             ;*          A = Y position value
0017+  EE58             ;*
0018+  EE58             ;* msgent - Manual Text display (assumes position set)
0019+  EE58             ;*       
0020+  EE58             ;*******************************************************
0021+  EE58             ;Local Vars
0022+  EE58             ;msg_x 	= temp1
