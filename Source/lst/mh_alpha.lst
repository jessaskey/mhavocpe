1834+  FE5A                 .sbttl "Self Test Main Message Routine"
1835+  FE5A             ;*******************************************************
1836+  FE5A             ;* Will output specified message to specified location 
1837+  FE5A             ;* on screen.                                          
1838+  FE5A             ;*                             
1839+  FE5A             ;* stmesg - Normal Message routine, uses all defaults                       
1840+  FE5A             ;*  Inputs: X = message # 
1841+  FE5A             ;*
1842+  FE5A             ;* stmesgv - Override Vertical Position
1843+  FE5A             ;*  Inputs: X = message # 
1844+  FE5A             ;*          A = vertical position value
1845+  FE5A             ;*
1846+  FE5A             ;* stmesgc - Override Color and Scale
1847+  FE5A             ;*  Inputs: X = message # 
1848+  FE5A             ;*	        A = Color 
1849+  FE5A             ;*
1850+  FE5A             ;* Internal Parameters:                
1851+  FE5A             ;*
1852+  FE5A             ;*    temp4 - Message Index (Limited to 256 entries)
1853+  FE5A             ;*  temp2+1 - Color and Scale
1854+  FE5A             ;*    temp2 - Y Position of Text
1855+  FE5A             ;*    temp1 - X Position Text
1856+  FE5A             ;*  litrast - ZP Pointer to Msg Table for Indexed Indirect Addressing mode
1857+  FE5A             ;*******************************************************
1858+  FE5A 85 0E       stmesgc	sta temp2+1
1859+  FE5C 86 11       		stx temp4
1860+  FE5E BD A1 FA    		lda msgtblvy,X        ;Store Y Position
1861+  FE61 85 0D       		sta temp2
1862+  FE63 4C 78 FE    		jmp ?stms
1863+  FE66             
1864+  FE66 85 0D       stmesgv sta temp2
1865+  FE68 86 11       		stx temp4
1866+  FE6A 4C 74 FE            jmp stmesg_
1867+  FE6D                     
1868+  FE6D BD A1 FA    stmesg 	lda msgtblvy,X        ;Store Y Position
1869+  FE70 86 11               stx temp4
1870+  FE72 85 0D               sta temp2
1871+  FE74 A9 00       stmesg_ lda #0
1872+  FE76 85 0E       		sta temp2+1				;Clear Color + Scale Override (signifies that 
1873+  FE78             								;this won't be used and table value will be)
1874+  FE78 BD 3D FA    ?stms   lda msgtblvx,X        	;Get the X Position 
1875+  FE7B 85 0B               sta temp1
1876+  FE7D 20 B1 D6            jsr vgcntr 
1877+  FE80 A9 00               lda #00
1878+  FE82 85 00               sta vgbrit
1879+  FE84 A9 02               lda #02
1880+  FE86 20 C8 D6            jsr vgscalz              ;a=binary scaling value, linear scaling value = 0
1881+  FE89 A5 0B               lda temp1
1882+  FE8B A6 0D               ldx temp2
1883+  FE8D 20 D5 D6            jsr vgvtr1              ;Position Beam (Use vgbrit) 
1884+  FE90 A5 11               lda temp4               ;Set up ptr to literal
1885+  FE92 0A                  asl A                   ;X2 for words
1886+  FE93 A8                  tay
1887+  FE94 B1 26               lda (litrast,Y)         ;Get X (vert) position
1888+  FE96 85 1F               sta vdata
1889+  FE98 C8                  iny 
1890+  FE99 B1 26               lda (litrast,Y)
1891+  FE9B 85 20               sta vdata+1
1892+  FE9D             		;begin color and scale stuff
1893+  FE9D A5 0E       		lda temp2+1
1894+  FE9F             		\ .push  *, 0 \ BNE  * 		
1894+  FE9F             
1894+  FE9F D0 FE       
1895+  FEA1 A6 11       			ldx temp4
1896+  FEA3 BD D9 F9    			lda msgtblst,X          ;color and scale of text now
