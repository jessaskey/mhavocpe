0002+  D5F7 2E5457564543    .TEXT ".TWVECTOR."
0002+  D5FD 544F522E
0003+  D601             ;*****************************************************
0004+  D601                 .title "TWVECTOR - Vector Routines" 
0005+  D601                 .sbttl "Vector List Sequencer"
0006+  D601             ;*****************************************************
0007+  D601             ;* This routine will be used to copy vectors from    *
0008+  D601             ;* ROM to VGRAM, 1 at a time, making the last      *
0009+  D601             ;* drawn vector brighter.                            *
0010+  D601             ;* Limits: Ths source pics must be in the fixed      *
0011+  D601             ;*         vector page. No more than 3 of these      *
0012+  D601             ;*         allowed.                                  *
0013+  D601             ;*                                                   *
