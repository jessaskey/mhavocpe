0006+  27FE             ;* Message Macro                             
0007+  27FE             ;* Will build an absolute address table here 
0008+  27FE             ;* of each message. Space for table has to be
0009+  27FE             ;* initially declared adequately. The macro  
0010+  27FE             ;* will also define a new label for each     
0011+  27FE             ;* message that can be used to get the       
0012+  27FE             ;* proper index into the message table.      
0013+  27FE             ;*********************************************
0014+  27FE             ___msgnum = 0
0015+  27FE             ___numsgs = 190d	
0016+  27FE             ___templen = 0
0017+  27FE             ___messtmp = 0
0018+  27FE             
0019+  27FE             messptrl .block ___numsgs
0020+  28BC             messptrh .block ___numsgs
0021+  297A             messscol .block ___numsgs
0022+  2A38             messypos .block ___numsgs
0023+  2AF6             messxpos .block ___numsgs
0024+  2BB4             
0025+  2BB4             #define     mess(xlit,xcol,xsca,ypos,xpos)  \___messtmp .set $
0026+  2BB4             #defcont	\ .org (messptrl+___msgnum)
0027+  2BB4             #defcont    \ .byte (xlit&$FF)
0028+  2BB4             #defcont    \ .org (messptrh+___msgnum)
0029+  2BB4             #defcont    \ .byte ((xlit/$100)&$FF)
0030+  2BB4             #defcont    \ .org (messscol + ___msgnum)
0031+  2BB4             #defcont    \ .byte ((xcol*$10)|(xsca))
0032+  2BB4             #defcont    \ .org (messypos+___msgnum)
0033+  2BB4             #defcont    \ .byte ypos
0034+  2BB4             #defcont    \ .org (messxpos+___msgnum)
0035+  2BB4             #defcont    \ .byte xpos
0036+  2BB4             #defcont    \m+xlit = ___msgnum
0037+  2BB4             #defcont    \___msgnum .set ___msgnum+1
0038+  2BB4             #defcont    \#if (___numsgs < ___msgnum) 
0039+  2BB4             #defcont    \ .error "MSG: Number of messages exceeds defined limit, increase please!"
0040+  2BB4             #defcont    \#endif 
0041+  2BB4             #defcont    \ .org ___messtmp
0042+  2BB4             
