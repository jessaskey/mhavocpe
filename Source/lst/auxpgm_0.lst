0052+  2BB4             #defcont    \ .byte ypos
0053+  2BB4             #defcont    \ .org (messxpos+___msgnum)
0054+  2BB4             #defcont    \ .byte (-1*((___templen)*3))
0055+  2BB4             #defcont    \m+xlit = ___msgnum
