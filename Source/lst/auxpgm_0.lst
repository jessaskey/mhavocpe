0411++ 39DA 4A4A4A4A4A4A4A4A4A4A4A4A4A4A4A4A4A4A4A4A4A4A4A4A4A4A4A4A4A4A4A4A4A4A4A4A4A4A4A4ACA
0412++ 3A03 26303A3C383Esco20   	.ctext "INSTRUCTIONS"
0412++ 3A09 1A3C263230BA
0413++ 3A0F 044A003E3A1Esco21   	.ctext "1. USE TACT SCAN FOR WARPING AND INFORMATION"
0413++ 3A15 003C161A3C003A1A16300020323800421638342630220016301C0026302032382E163C2632B0
0414++ 3A3B 064A001C1E3Asco22   	.ctext "2. DESTROY MAINFRAME DEFENSES"
0414++ 3A41 3C383246002E1626302038162E1E001C1E201E303A1EBA
0415++ 3A58 084A002C1630sco23   	.ctext "3. LAND ON WHITE PLATFORM OF DEFEATED MAINFRAME"
0415++ 3A5E 1C003230004224263C1E00342C163C2032382E003220001C1E201E163C1E1C002E1626302038162E9E
0416++ 3A87 0A4A00263000sco24   	.ctext "4. IN MAZE, FIND THE REACTOID AND TOUCH IT"
0416++ 3A8D 2E16481E50002026301C003C241E00381E161A3C32261C0016301C003C323E1A240026BC
0417++ 3AB1 0C4A001E4426sco25   	.ctext "5. EXIT MAZE BEFORE REACTOID BLOWS UP"
0417++ 3AB7 3C002E16481E00181E2032381E00381E161A3C32261C00182C32423A003EB4
0418++ 3AD6 80          sco26   	.ctext " "
0419++ 3AD7 000030323C1Esco27   	.ctext "  NOTE--HOLD JUMP BUTTON FOR HIGHER JUMPS"
0419++ 3ADD 4E4E24322C1C00283E2E3400183E3C3C32300020323800242622241E3800283E2E34BA
0420++ 3B00             
0421++ 3B00 16221626303Aendtx00		.ctext "AGAINST ALL ODDS, YOU, MAJOR HAVOC,"	
0421++ 3B06 3C00162C2C00321C1C3A500046323E50002E1628323800241640321AD0
0422++ 3B23 16301C004632endtx01  	.ctext "AND YOUR LITTER OF CLONES, HAVE REACHED"
0422++ 3B29 3E38002C263C3C1E38003220001A2C32301E3A50002416401E00381E161A241E9C
0423++ 3B4A 3C241E004016endtx02		.ctext "THE VAXXIAN HOMEWORLD AND DEALT THE"
0423++ 3B50 44442616300024322E1E4232382C1C0016301C001C1E162C3C003C249E
0424++ 3B6D 401644442616endtx03		.ctext "VAXXIAN EMPIRE A TERMINAL BLOW AND PURGED"
0424++ 3B73 30001E2E3426381E0016003C1E382E2630162C00182C32420016301C00343E38221E9C
0425++ 3B96 3C241E2E0020endtx04		.ctext "THEM FROM THE GALAXY."
0425++ 3B9C 38322E003C241E0022162C164446CA
0426++ 3BAB 80          endtx05 	.ctext " "
0427++ 3BAC 46323E380034endtx06		.ctext "YOUR PEOPLE HAVE BEEN FREED TO RETURN"
0427++ 3BB2 1E32342C1E002416401E00181E1E300020381E1E1C003C3200381E3C3E38B0
0428++ 3BD1 3C32003C241Eendtx07		.ctext "TO THEIR LAND, GO PHISHING, BUILD A"
0428++ 3BD7 2638002C16301C50002232003424263A242630225000183E262C1C0096
0429++ 3BF4 2026381E4216endtx08		.ctext "FIREWALL, ATTEND A BOOT CAMP, AND SEEK"
0429++ 3BFA 2C2C5000163C3C1E301C0016001832323C001A162E34500016301C003A1E1EAA
0430++ 3C1A 16002C26201Eendtx09 	.ctext "A LIFE FREE OF THE VAXX. EVENTUALLY,"
0430++ 3C20 0020381E1E003220003C241E00401644444A001E401E303C3E162C2C46D0
0431++ 3C3E 3C241E460042endtx0a		.ctext "THEY WILL PROCESS THE FACT THAT THEY"
0431++ 3C44 262C2C003438321A1E3A3A003C241E0020161A3C003C24163C003C241EC6
0432++ 3C62 16381E002038endtx0b		.ctext "ARE FREE."
0432++ 3C68 1E1ECA
0433++ 3C6B 80          endtx0c		.ctext " "
0434++ 3C6C 183E3C002032endtx0d     .ctext "BUT FOR YOU, THERE IS STILL WORK TO BE"
0434++ 3C72 380046323E50003C241E381E00263A003A3C262C2C004232382A003C3200189E
0435++ 3C92 1C32301E4A00endtx0e		.ctext "DONE. SOME VAXXIAN SPACE STATIONS ARE"
0435++ 3C98 3A322E1E0040164444261630003A34161A1E003A3C163C2632303A0016389E
0436++ 3CB7 3A3C262C2C00endtx0f		.ctext "STILL ROAMING THE GALAXY, UNAWARE THAT"
0436++ 3CBD 3832162E263022003C241E0022162C16444650003E30164216381E003C2416BC
0437++ 3CDD 3C241E263800endtx10		.ctext "THEIR HOMEWORLD HAS CRASHED."
0437++ 3CE3 24322E1E4232382C1C0024163A001A38163A241E1CCA
0438++ 3CF9 80          endtx11		.ctext " "
0439++ 3CFA 303242500046endtx12		.ctext "NOW, YOU AND YOUR CLONES CAN WARP"
0439++ 3D00 323E0016301C0046323E38001A2C32301E3A001A163000421638B4
0440++ 3D1B 1638323E301Cendtx13		.ctext "AROUND THE GALAXY, AND TOSS THE REST"
0440++ 3D21 003C241E0022162C164446500016301C003C323A3A003C241E00381E3ABC
0441++ 3D3F 3220003C241Eendtx14		.ctext "OF THESE SPACE STATIONS INTO THE GARBAGE"
0441++ 3D45 3A1E003A34161A1E003A3C163C2632303A0026303C32003C241E002216381816229E
0442++ 3D67 1A322C2C1E1Aendtx15		.ctext "COLLECTOR."
0442++ 3D6D 3C3238CA
0443++ 3D71 80          endtx16		.ctext " "
0444++ 3D72 1A3230223816endtx17		.ctext "CONGRATULATIONS MAJOR HAVOC, YOU HAVE DONE WELL."
