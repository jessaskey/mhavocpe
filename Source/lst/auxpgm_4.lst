0146+  0000             IDENTIFIER_V2 = 13d
0147+  0000             IDENTIFIER_V3 = 14d
0148+  0000             IDENTIFIER_GG = 15d
0149+  0000             IDENTIFIER_BL = 16d
0150+  0000             IDENTIFIER_BH = 17d
0151+  0000             
0152+  0000             IDCOUNT	.equ IDENTIFIER_BH + 1 - IDENTIFIER_AL
