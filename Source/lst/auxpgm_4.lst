0005+  2011             ;***********************************************
0006+  2011             	.title  "Space Maze - Display the Maze"
0007+  2011             	.sbttl  "Space Maze Constants"
0008+  2011             ;***********************************************
0009+  2011             ;* Some Constants 
0010+  2011             nweb		=	12d	            ;Number of web spinners
0011+  2011             maxlin		=	(nweb+1)*8	    ;Maximum number of line vertices,8 per spinner
0012+  2011             maxinv		=	$10
0013+  2011             maxhitln	=	$0F				;Maximum number of hits a line may take
