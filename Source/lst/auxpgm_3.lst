0189+  2146             ;*************************************************
0190+  2146                 .sbttl "Gun Location"
0191+  2146             ;*************************************************
0192+  2146             ;* Determines the X and Y location of the gun    *
0193+  2146             ;* based on the current rotation of the base and *
0194+  2146             ;* which face the gun is on.                     *
0195+  2146             ;*                                               *
0196+  2146             ;* Inputs:  temp8,saupic,statx,staty             *
0197+  2146             ;*          temp8 = face select                  *
0198+  2146             ;*          a = face (if entry at gunlc2)        *
0199+  2146             ;*                                               *
0200+  2146             ;* Output:  vdata(2) = x posit           *
0201+  2146             ;*          vdata+2(2) = same for y              *
0202+  2146             ;*                                               *
0203+  2146             ;* Uses:    A,X,temp8                            *
0204+  2146             ;*                                               *
0205+  2146             ;* Note: Results are also stored in the locs     *
0206+  2146             ;*       of the first 3 enemy space ships. The   *
0207+  2146             ;*       first one of these will be used later   *
0208+  2146             ;*       so the routines for dropping a shot may *
0209+  2146             ;*       be used in twenemy. These locs are not  *
0210+  2146             ;*       used during this space wave so no harm  *
0211+  2146             ;*       will occur.                             *
0212+  2146             ;*************************************************
0213+  2146 AD 23 08    ?gunloc lda statxl
0214+  2149 85 1F               sta vdata               ;For output of picture
0215+  214B 99 00 02            sta sobjxl,Y
0216+  214E AD 24 08            lda statxh
0217+  2151 85 20               sta vdata+1
0218+  2153 99 21 02            sta sobjxh,Y
0219+  2156 AD 25 08            lda statyl
0220+  2159 85 21               sta vdata+2
0221+  215B 99 42 02            sta sobjyl,Y
0222+  215E AD 26 08            lda statyh
0223+  2161 85 22               sta vdata+3         ;vdata+2 = gun's position y
0224+  2163 99 63 02            sta sobjyh,Y            ;for shot routine later
0225+  2166 60                  rts 
