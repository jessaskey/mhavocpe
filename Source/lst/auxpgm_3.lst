1166+  28A1             ;*********************************************************
1167+  28A1             ;* Shot to Shield Collision - this checks a specific
1168+  28A1             ;* slot for a collision with the incoming panel index.
1169+  28A1             ;* The calling routine will check the slots in an order
1170+  28A1             ;* that allows for checking collisions around the space 
1171+  28A1             ;* station properly.
1172+  28A1             ;*
1173+  28A1             ;* temp9 = X index to the shot
1174+  28A1             ;* USES LOCAL VARS DEFINED BELOW
1175+  28A1             ;*
1176+  28A1             ;* Returns A = $00 - No Hit
1177+  28A1             ;*         A = $80 - Hit
1178+  28A1             ;*********************************************************
1179+  28A1             ?targslot = temp7
1180+  28A1             ?curridx = temp7+1
