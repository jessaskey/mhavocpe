0021   6002 01 00       	.byte MAJOR_VERSION,MINOR_VERSION
0022   6004             ;*****************************************************************
0023   6004             	
0024   6004             thispage = vpage0
0025   6004             
0026   6004             ;*************************************
0027   6004                 .sbttl "Planes"
0028   6004             ;*************************************
0029   6004             plane_vpg   =   $60|thispage
0030   6004             
0031   6004                     
0032   6004             plne6   \#if ((34d&1>0)|(-42d&1>0)|(34d>=32d)|(-42d>=32d)|(34d<=-32)|(-42d<=-32))   \ \ .dw (-42d&$1fff)\ \ .dw ((34d&$1fff)+(hidden<<13))\#else\ \ .db (((34d>>1)&$1f)+(hidden<<5))\ \ .db (((-42d>>1)&$1f)|$40)\#endif
0032   6004             
0032   6004             
0032   6004 D6 1F       
0032   6006             
0032   6006 22 00       
0032   6008~            plne6   vctr(34d,-42d,hidden)
0032   6008~            plne6   vctr(34d,-42d,hidden)
0032   6008~            plne6   vctr(34d,-42d,hidden)
0032   6008~            plne6   vctr(34d,-42d,hidden)
0032   6008~            plne6   vctr(34d,-42d,hidden)
0032   6008             
0033   6008                     \#if ((-20d&1>0)|(-16d&1>0)|(-20d>=32d)|(-16d>=32d)|(-20d<=-32)|(-16d<=-32))   \ \ .dw (-16d&$1fff)\ \ .dw ((-20d&$1fff)+(visible<<13))\#else\ \ .db (((-20d>>1)&$1f)+(visible<<5))\ \ .db (((-16d>>1)&$1f)|$40)\#endif
0033   6008~                    vctr(-20d,-16d,visible)
0033   6008~                    vctr(-20d,-16d,visible)
0033   6008~                    vctr(-20d,-16d,visible)
0033   6008~                    vctr(-20d,-16d,visible)
0033   6008~                    vctr(-20d,-16d,visible)
0033   6008             
0033   6008             
0033   6008 36          
0033   6009             
0033   6009 58          
0033   600A             
0034   600A                     \#if ((-32d&1>0)|(0d&1>0)|(-32d>=32d)|(0d>=32d)|(-32d<=-32)|(0d<=-32))   \ \ .dw (0d&$1fff)\ \ .dw ((-32d&$1fff)+(visible<<13))\#else\ \ .db (((-32d>>1)&$1f)+(visible<<5))\ \ .db (((0d>>1)&$1f)|$40)\#endif
0034   600A             
0034   600A             
0034   600A 00 00       
0034   600C             
0034   600C E0 3F       
0034   600E~                    vctr(-32d,0d,visible)
0034   600E~                    vctr(-32d,0d,visible)
0034   600E~                    vctr(-32d,0d,visible)
0034   600E~                    vctr(-32d,0d,visible)
0034   600E~                    vctr(-32d,0d,visible)
0034   600E             
0035   600E                     \#if ((-20d&1>0)|(16d&1>0)|(-20d>=32d)|(16d>=32d)|(-20d<=-32)|(16d<=-32))   \ \ .dw (16d&$1fff)\ \ .dw ((-20d&$1fff)+(visible<<13))\#else\ \ .db (((-20d>>1)&$1f)+(visible<<5))\ \ .db (((16d>>1)&$1f)|$40)\#endif
0035   600E~                    vctr(-20d,16d,visible)
0035   600E~                    vctr(-20d,16d,visible)
0035   600E~                    vctr(-20d,16d,visible)
0035   600E~                    vctr(-20d,16d,visible)
0035   600E~                    vctr(-20d,16d,visible)
0035   600E             
0035   600E             
0035   600E 36          
