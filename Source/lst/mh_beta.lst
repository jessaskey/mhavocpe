0100+  0800             	
0101+  0800             ;*******************************************************************************
0102+  0800             ; COMRAM is shared between BETA and ALPHA and it is the primary 
0103+  0800             ; means that the ALPHA askes the BETA to do things regarding 
0104+  0800             ; object rotations;
0105+  0800             ;
0106+  0800             ; The COMRAM contains command structures for work. Each command
0107+  0800             ; is defined by the following structure array.
0108+  0800             ;
0109+  0800             ; BYTE# PARAM	DESCRIPTION
0110+  0800             ;------------------------------------------------------------------------
0111+  0800             ;   1	OBJINF	
0112+  0800             ;				$80 - Flag TO BETA signifying that this comannd is ready to process
0113+  0800             ;     			$40 - Flag to ALPHA signifying that this command is done
0114+  0800             ;				$20 - Not Used
0115+  0800             ;				$1F - The object to be transformed as defined in the BETA ROM (limit 32 objects)
0116+  0800             ;   2   XROT	The X rotation ranging from 0-255 (1.40625 degrees per step)
0117+  0800             ;   3   YROT	The Y "           "      "    "       "       "     "    "
0118+  0800             ;   4   ZROT	The Z "           "      "    "       "       "     "    "
0119+  0800             ;   5   SCALE	The Zoom or scale factor to render the object with
0120+  0800             ;	6/7 OBJOUT	The 2-byte address in COMRAM where the data begins
0121+  0800             ;   8	LENGTH	The length of the data stream IN WORDS (ALPHA sets this to 0 to start
0122+  0800             ;               and BETA will set it to the correct number when data is ready and BETA
0123+  0800             ;               is FINSHED with the command (along with flag in OBJINF)
0124+  0800             ;*******************************************************************************
0125+  0800             comsize = 8		;Each command as documented above is 8 bytes
0126+  0800             comlimt = 4		;Only 4 commands are allowed
0127+  0800             
0128+  4000             	.org comram
0129+  4000             
0130+  4000             commandtable	.block	comsize*comlimt		
0131+  4020             	
0132+  4020             	
0133+  4020             
0134+  4020             comtestbase	 .equ	$7f0
0135+  4020             
0136+  47F0             	.org comram+comtestbase
0137+  47F0             	
0138+  47F0             tstflag     .block 1    ;TEST flags $FF = all good
0139+  47F1             						;$80 - BETA RAM
0140+  47F1             						;$40 - COM RAM
0141+  47F1             						;$20 - ROM LOW 
0142+  47F1             						;$10 - ROM HIGH
0143+  47F1             pgcstbl     .block 2d  	;ROM checksums go here
0144+  47F3             pgidtbl		.block 2d	;ROM Identifier Byte
0145+  47F5             pgvetbl		.block 4d	;ROM Version Word
