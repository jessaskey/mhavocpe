0049+  0001             curobjptr	.block  2
0050+  0003             curvtx		.block	2
0051+  0005             curvty		.block	2
0052+  0007             curvtz		.block	2
0053+  0009             thetax		.block  1
0054+  000A             thetay		.block  1
0055+  000B             thetaz		.block  1
0056+  000C             curscal		.block  1
0057+  000D             temp1		.block	2
0058+  000F             temp2		.block	2
0059+  0011             temp3		.block	2
0060+  0013             
0061+  0013             A11      	.block	1	;$41          ;Local rotation matrix
0062+  0014             B12      	.block 	1	;$42
0063+  0015             C13      	.block 	1	;$43
0064+  0016             D21      	.block 	1	;$44
0065+  0017             E22      	.block 	1	;$45
0066+  0018             F23      	.block 	1	;$46
0067+  0019             G31      	.block 	1	;$47
0068+  001A             H32      	.block 	1	;$48
0069+  001B             I33      	.block 	1	;$49
0070+  001C             
0071+  001C             vtxcache	.block maxvertex
0072+  0080             
0073+  0080             
0074+  0080             
0075+  0080             ;*****************************************************************
0076+  0080             ;We need at least 32 bytes for the Stack
0077+  0080             ;*****************************************************************
0078+  0080             	\ #IF $ > ($0200-$20)\	.error "ORG definition ($0200-$20) is LOWER than the current address($). Check listing for overlap."\ #ENDIF\ .org $0200-$20
0078+  0080~            	orgchk($0200-$20,$)
0078+  0080~            	orgchk($0200-$20,$)
0078+  0080             
0078+  01E0             
0079+  01E0             
0080+  01E0             ;*****************************************************************
0081+  01E0             ; Non Zero Page vars can be here NOTE: They are slower than ZP RAM
0082+  01E0             ;*****************************************************************
0083+  01E0             	\ #IF $ > ($0200)\	.error "ORG definition ($0200) is LOWER than the current address($). Check listing for overlap."\ #ENDIF\ .org $0200
0083+  01E0~            	orgchk($0200,$)
0083+  01E0~            	orgchk($0200,$)
0083+  01E0             
0083+  0200             
0084+  0200             
0085+  0200             
