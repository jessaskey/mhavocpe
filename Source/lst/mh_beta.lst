0579+  D3A5                      ; SEC
0580+  D3A5                      ; SBC (MULTLO2),Y
0581+  D3A5                      ; STA ]1
0582+  D3A5                      ; LDA (MULTHI1),Y
0583+  D3A5                      ; SBC (MULTHI2),Y
0584+  D3A5             ; DONE     <<<
0585+  D3A5             
0586+  D3A5             ; QMULTAY  MAC              ;Assumes pointers already set up
0587+  D3A5                      ; LDA (MULTLO1),Y
0588+  D3A5                      ; SEC
