0124+  D1B2             CZLO     = $AB
0125+  D1B2             CZHI     = $AD
0126+  D1B2             
0127+  D1B2             MATMULT  = $AF            ;Pointer to matrix mult. tables
0128+  D1B2             
0129+  D1B2             MULTLO1  .equ $B1          ;Same tables used by POLYFILL
0130+  D1B2             MULTLO2  .equ $B3
0131+  D1B2             MULTHI1  .equ $B5
0132+  D1B2             MULTHI2  .equ $B7
0133+  D1B2             
0134+  D1B2             PLISTXLO .equ $BD          ;Place to store rotprojed
