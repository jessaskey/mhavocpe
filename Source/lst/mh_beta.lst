0003+  D1B2             ;* LIB3D by Steven L. Judd (1999) - a 6502 3D library
0004+  D1B2             ;************************************************************
0005+  D1B2             ;* http://www.ffd2.com/fridge/obj3d/lib3dv2.ref 
0006+  D1B2             ;************************************************************
0007+  D1B2             ;* Ported to the 6502 BETA by Jess M. Askey (2021)
0008+  D1B2             ;************************************************************      
0009+  D1B2             
0010+  D1B2             ; *-------------------------------
0011+  D1B2             
0012+  D1B2             ; CDEL     .equ $C600        ;x*cos(delta)
0013+  D1B2             ; CDELREM  .equ $C700        ;remainder
0014+  D1B2             ; SDEL     .equ $C800
0015+  D1B2             ; SDELREM  .equ $C900
0016+  D1B2             ; PROJTAB  .equ $CA00        ;Projection table
0017+  D1B2             ; PROJREM  .equ $CB00        ;remainder
0018+  D1B2             ; SIN      .equ $CF00
0019+  D1B2             ; COS      .equ $CF20
0020+  D1B2             
0021+  D1B2             ; $C000-$C2FF	MULTLO, pointed to by $F7-$F8 and $F9-$FA
0022+  D1B2             ; $C300-$C5FF	MULTHI, pointed to by $FB-$FC and $FD-$FE
0023+  D1B2             ; $C600-$C6FF	CDEL, table of f(x)=x*cos(delta)
0024+  D1B2             ; $C700-$C7FF	CDELREM  remainder
0025+  D1B2             ; $C800-$C8FF	SDEL	x*sin(delta)
0026+  D1B2             ; $C900-$C9FF	SDELREM
0027+  D1B2             ; $CA00-$CAFF	PROJTAB, projection table, f(x)=d/x, integer part
0028+  D1B2             ; $CB00-$CBFF	PROJREM, projection table, 256*remainder
0029+  D1B2             ; $CC00-$CCFF	LOG, logarithm table
0030+  D1B2             ; $CD00-$CDFF	EXP, exponential table
0031+  D1B2             ; $CE00-$CEFF	NEGEXP, exponential table
0032+  D1B2             ; $CF00-$CFFF	TRIG, table of 32*sin(2*pi*x/128) -- 160 bytes.
0033+  D1B2             ;
0034+  D1B2             ; The tables from $C600-$CFFF are fixed and must not be moved.  The
0035+  D1B2             ; tables ROTMATH, MULTLO, and MULTHI on the other hand are only
0036+  D1B2             ; accessed indirectly, and thus may be relocated.  Thus there is
0037+  D1B2             ; room for a color map and eight sprite definitions in any VIC bank
0038+  D1B2             ; except bank 2, where lib3d is located (only enough room for a
0039+  D1B2             ; bitmap there).
0040+  D1B2             
0041+  D1B2             
0042+  D1B2             XOFFSET  .equ $53          ;Center of the screen
0043+  D1B2             YOFFSET  .equ $54
