0003+  0000             ;***********************************************************
0004+  0000             ;* BETA Memory Map
0005+  0000             ;*
0006+  0000             ;* 
0007+  0000             ;*
0008+  0000             ;* 0000-07FF -> RAM @ E1
0009+  0000             ;* 4000-47FF -> COMRAM @ F1
0010+  0000             ;* 8000-BFFF -> 27128 @ C1
0011+  0000             ;* C000-FFFF -> 27128 @ D1
0012+  0000             ram			= 	$0000	;RAM
0013+  0000             comram		=	$4000	;ALPHA Communication RAM
0014+  0000             program     =   $8000   ;Program Memory Start
0015+  0000             program2	=   $C000	;Second ROM
0016+  0000             
0017+  0000             
0018+  0000             ;***********************************************************
0019+  0000             ; Constants
0020+  0000             ;***********************************************************
0021+  0000             
0022+  0000             maxvertex	= 100d
0023+  0000             
0024+  0000             colblack    =   $0
0025+  0000             colblue     =   $1
0026+  0000             colgreen    =   $2
0027+  0000             colcyan     =   $3
0028+  0000             colred      =   $4
0029+  0000             colpurple   =   $5
0030+  0000             colyellow   =   $6
0031+  0000             colwhite    =   $7
0032+  0000             colwhiter   =   $8
0033+  0000             colpink     =   $9
0034+  0000             colorange   =   $A
0035+  0000             colred2     =   $B			;this used to be called colredr
0036+  0000             colflash     =  $C
0037+  0000             colcyanr    =   $D
0038+  0000             colbluer    =   $E
0039+  0000             colgreenr   =   $F
0040+  0000             
