2604+  31D9                 .sbttl "Perkoid Draw Routine"
2605+  31D9             ;**********************************************
2606+  31D9             ;* This routine draws the robots in 4 stages. *
2607+  31D9             ;*                                            *
2608+  31D9             ;* 1). The body is always the same.           *
2609+  31D9             ;* 2). The head is next. objst is used to     *
2610+  31D9             ;*     determine which of the 7 head pics is  *
2611+  31D9             ;*     drawn.                                 *
2612+  31D9             ;* 3). The tail is then added. velxh is used  *
2613+  31D9             ;*     to determine which fo 3 tails is added.*
2614+  31D9             ;*     If moving left, tail goes right, etc.  *
2615+  31D9             ;* 4). Then the gun is drawn. this is only    *
2616+  31D9             ;*     drawn if the head is open. Again, objst*
2617+  31D9             ;*     will determine which of 4 gun pics is  *
2618+  31D9             ;*     drawn.                                 *
2619+  31D9             ;* 5). Eyes are last.                         *
2620+  31D9             ;*                                            *
2621+  31D9             ;* Inputs: objst(x),velxh(x), (temp9) = (x)   *
2622+  31D9             ;*         robdir(x-zrobot),(temp8+1)=velxh(x)*
2623+  31D9             ;*                                            *
2624+  31D9             ;* Outputs: vectors to vglist                 *
2625+  31D9             ;*                                            *
2626+  31D9             ;* Uses: A,X,Y,temp7,temp8,temp9              *
2627+  31D9             ;**********************************************
2628+  31D9             ;* NOTE : drawrobm is below
2629+  31D9             ;**********************************************
2630+  31D9 A9 30       drawrob lda #$30
2631+  31DB A2 72               ldx #$72                ;scale
2632+  31DD 20 B5 D6            jsr vgadd2
2633+  31E0 A6 1B               ldx temp9               ;Object x
2634+  31E2 BD A2 03            lda objst-zrobot+zshot,X    ;A shot with this robot
2635+  31E5 48                  pha                     ;Save for body decision
2636+  31E6 BD 74 06            lda robdir-zrobot,X     ;Velocity is flip
2637+  31E9                     \ .push  *, 0 \ BMI  * 
2637+  31E9             
2637+  31E9 30 FE       
2638+  31EB A2 62                   ldx #body_vpg           ;Stat and page select
