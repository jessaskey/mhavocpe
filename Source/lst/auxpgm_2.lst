3870+  3938             ;***************************************************
3871+  3938                 .sbttl "Top Line collisions other than Rex/Max"
3872+  3938             ;***************************************************
3873+  3938             ;* This routine is for objects moving in    
3874+  3938             ;* the maze other than the man. All ground  
3875+  3938             ;* and bottom wall collisions for objects   
3876+  3938             ;* are handled as if the man, but above     
3877+  3938             ;* collisions are not the same.             
3878+  3938             ;*                                          
3879+  3938             ;* Input:  Y = object index pointer         
3880+  3938             ;*         Y,headocl = possible head col    
3881+  3938             ;*                                          
3882+  3938             ;* Output: Will set proper collision bits   
3883+  3938             ;****************************************************   
3884+  3938             ; Top Line case table       
3885+  3938 5B 39       objhcs  .word objhc0-1
3886+  393A 5B 39               .word objhc1-1
3887+  393C 5C 39               .word objhc2-1
3888+  393E 5C 39               .word objhc3-1
3889+  3940 6F 39               .word objhc4-1
3890+  3942 6F 39               .word objhc5-1
3891+  3944 82 39               .word objhc6-1
3892+  3946 A4 39               .word objhc7-1
3893+  3948             objhce  ;End of table marker
3894+  3948             
3895+  3948 AD 0D 08    objhcse lda abvstmp     ;Stamp we might hit
3896+  394B 0A                  asl a
3897+  394C AA                  tax 
3898+  394D E0 10               cpx #objhce-objhcs
3899+  394F                     \ .push  *, 0 \ BCC  * 
