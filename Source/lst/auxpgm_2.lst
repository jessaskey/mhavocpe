3464+  373A             ;*******************************************
3465+  373A                 .sbttl "Max Bottom/Ground Case Table"
3466+  373A             ;*******************************************
3467+  373A             ;* Collision case routine for ground    
3468+  373A             ;* collisions. Requires 'curstmp' to    
3469+  373A             ;* contain current stamp type the man   
3470+  373A             ;* is standing in. Also requires that   
3471+  373A             ;* temp3 & temp4 contain X and Y        
3472+  373A             ;* positions.                           
3473+  373A             ;* Will return as a subroutine          
3474+  373A             ;*                                      
3475+  373A             ;* Caution: (Y) = Object Index          
3476+  373A             ;*          (Also in zindex)            
3477+  373A             ;*******************************************
3478+  373A 63 37       maxbcs 	.word maxb0-1
3479+  373C 64 37               .word maxb1-1      ;Stamp 1 (H Line)
3480+  373E 6B 37               .word maxb2-1      ;Stamp 2 (H end, right down)
3481+  3740 8C 37               .word maxb3-1      ;Stamp 3 (H end, right up)
3482+  3742 A6 37               .word maxb4-1      ;Stamp 4 (H end, left up)
3483+  3744 C0 37               .word maxb5-1      ;Stamp 5 (H end, left down)
3484+  3746 E1 37               .word maxb6-1      ;Stamp 6 (V Line)
3485+  3748 6B 38               .word maxb7-1      ;Stamp 7 (Black)
3486+  374A             maxbce 	;end of table marker
3487+  374A             
3488+  374A             
3489+  374A             maxbcse 
3490+  374A A4 F7       		ldy zindex      	;Index of object we are colliding with
3491+  374C A9 00       		lda #00
3492+  374E 99 5B 00            sta rtcol,Y
3493+  3751 99 23 00            sta ltcol,Y
3494+  3754 AD 0C 08            lda curstmp     	;Current Stamp
3495+  3757 29 07               and #$07
3496+  3759 0A                  asl a           	;words
3497+  375A AA                  tax             	;into X
3498+  375B                     ;cpx #maxbce-maxbcs  ;Valid stamp?
3499+  375B                     ;ifcs                ;not valid (NOTE: JMA - This should never happen, maybe check and this can come out?)
3500+  375B                     ;    ldx #02         ;Set to line for now
3501+  375B                     ;endif
3502+  375B BD 3B 37            lda maxbcs+1,X
