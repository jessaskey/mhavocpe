0558+  280E             ; 0x02-0x11		Pyroid/Fireball
0559+  280E             ; 0x12-0x19		Laser Cannon Shots
0560+  280E             ; 0x1a-0x1d		Laser Cannons
0561+  280E             ; 0x1e-0x27		Perkoids
0562+  280E             ; 0x28-0x31		Perkoid Shots
