0472+  280E                    
0473+  280E             ;************************************************
0474+  280E                 .sbttl "Code for Cannon Data Sets"
0475+  280E             ;************************************************
0476+  280E             ;* First Byte:                                  
0477+  280E             ;*    D7-D6 = 00    Return to start of list       
0478+  280E             ;*    D7-D6 = 01    Move Gun to a new orientation 
0479+  280E             ;*                                              
0480+  280E             ;*          D5-D3 = Angle of Gun:               
0481+  280E             ;*                = 000 Top Right               
0482+  280E             ;*                = 001 Middle Right            
0483+  280E             ;*                = 010 Bottom Right            
0484+  280E             ;*                = 011 Point Down              
0485+  280E             ;*                = 100 Top Left                
0486+  280E             ;*                = 101 Middle Left             
0487+  280E             ;*                = 110 Bottom Left 
0488+  280E             ;*
0489+  280E             ;* 			D2-D1 = Rotation Speed (0-3)
0490+  280E             ;*			D0 = Fire Bit (Shot Velocity in next byte)
0491+  280E             ;*
0492+  280E             ;*			Second Byte: Shot Velocity (optional)
0493+  280E             ;*                                              
0494+  280E             ;*    D7-D6 = 10  Move Gun Location             
0495+  280E             ;*                                              
0496+  280E             ;*          D5-D0 = Frames of wait time/4       
0497+  280E             ;*                = 0  Then Zero X and Y vel.   
0498+  280E             ;*                > 0  Then Velocities Follow   
0499+  280E             ;*          Second Byte: X MSB Velocity (optional)         
0500+  280E             ;*          Third Byte:  Y MSB Velocity (optional)         
0501+  280E             ;*                                              
0502+  280E             ;*    D7-D6 = 11  Pause                         
0503+  280E             ;*          D5-D0 = Frames of wait time/4       
0504+  280E             ;*
