0001   0000             #include "vector.ah"
0001+  0000             ;***********************************************************
0002+  0000             ;* Atari Vector Macros for TASMx                           
0003+  0000             ;***********************************************************
0004+  0000             ;* Written by Jess M. Askey 2000-2001                      
0005+  0000             ;* Version 1.3                                             
0006+  0000             ;*                                                         
0007+  0000             ;* Change Log:                                             
0008+  0000             ;*                                                         
0009+  0000             ;* 05/11/2000 Ver 1.0 - Initial Creation                   
0010+  0000             ;* 23/02/2001 Ver 1.1 - Added Comments and Descriptions      
0011+  0000             ;* 19/05/2001 Ver 1.2 - Combined LVCTR and VCTR macros into   
0012+  0000             ;*                      single macro (VCTR)that will select   
0013+  0000             ;*                      the correct vector instruction to  
0014+  0000             ;*                      use, based on the data.            
0015+  0000             ;*                                                         
0016+  0000             ;***********************************************************
0017+  0000             	.title 	"Macro Definitions"
0018+  0000             	.sbttl 	"Vector Macros"
0019+  0000             ;***********************************************************
0020+  0000             ;* NOTE: Comments in #DEFINE or #DEFCONT directives are    
0021+  0000             ;*       not allowed.                                      
0022+  0000             ;***********************************************************
0023+  0000             .module mvector
0024+  0000             
0025+  0000             ; #DEFINE	lbyte(add)	(add&$ff)
0026+  0000             ; #DEFINE	ubyte(add)	(add&$ff00)/$100
0027+  0000             #DEFINE	lxl(add)	.db $a2 \ .dw add  \ .org *-1
0028+  0000             #DEFINE	lxh(add)	.db $a2 \ .msfirst \ .dw add \ .lsfirst \.org *-1
0029+  0000             #DEFINE	lal(add)	.db $a9 \ .dw add   \ .org *-1
0030+  0000             #DEFINE	lah(add)	.db $a9 \ .msfirst \ .dw add \ .lsfirst \.org *-1
0031+  0000             #DEFINE	badl(add)	.db add
0032+  0000             #DEFINE	badh(add)	.msfirst \ .db add \ .lsfirst
0033+  0000             #DEFINE	adcl(add)	.db $69 \ .dw add   \ .org *-1
0034+  0000             #DEFINE laljsr(add)	.db $A9 \ jsrl(add) \ .org *-1
0035+  0000             #DEFINE	lxhjsr(add)	.db $A2 \ .msfirst  \ jsrl(add) \ .lsfirst \.org *-1
0036+  0000             
0037+  0000             ;***********************************************************
0038+  0000             ;* Vector Macro Definitions                                *
0039+  0000             ;***********************************************************
0040+  0000             	.sbttl 	"Vector Macro Definitions"
0041+  0000             	
0042+  0000             ;STAT Bit Defines (MH Only)	
0043+  0000             v_xflip		=	$04	;XFlip Bit
0044+  0000             v_sparkle	=	$08	;Sparkle Bit
0045+  0000             
0046+  0000             vbrite		= 1
0047+  0000             voff		= 0
0048+  0000             
0049+  0000             sparkle_on 	= 1
0050+  0000             sparkle_off = 0
0051+  0000             xflip_on	= 1
0052+  0000             xflip_off 	= 0
0053+  0000             ywin_on		= 1
0054+  0000             ywin_off	= 0
0055+  0000             
0056+  0000             binscal0	= 0
0057+  0000             binscal1	= 1
0058+  0000             binscal2	= 2
0059+  0000             binscal3	= 3
0060+  0000             binscal4	= 4
0061+  0000             binscal5	= 5
0062+  0000             binscal6	= 6
0063+  0000             binscal7 	= 7
0064+  0000             
0065+  0000             vpage0	= 0
0066+  0000             vpage1	= 1
0067+  0000             vpage2	= 2
0068+  0000             vpage3	= 3
0069+  0000             
0070+  0000             
0071+  0000             ;*********************************************************************************************************************	
0072+  0000             ;* VECTOR ROM Formatted Macros
0073+  0000             ;*********************************************************************************************************************	
0074+  0000             ;* Center Macro: This will center the beam on the screen for accurate drawing.
0075+  0000             ;*********************************************************************************************************************
0076+  0000             #DEFINE	vcntr							.db $20,$80
0077+  0000             
0078+  0000             ;*********************************************************************************************************************
0079+  0000             ;* Halt Macro: This macro stops the Vector Generator from drawing, drawing cannot proceed unless the 
0080+  0000             ;*            Vector Generator is reset and drawing begins from the start of the VRAM.
0081+  0000             ;*********************************************************************************************************************
0082+  0000             #DEFINE	vhalt							.db $00,$20
0083+  0000             
0084+  0000             ;*********************************************************************************************************************
0085+  0000             ;* Jump Subroutine Macro: Causes the Vector Generator to jump to a drawing subroutine give by a
0086+  0000             ;*                       name passed in the macro. This instruction will push the current address
0087+  0000             ;*                       location onto the vector generator stack (which is four deep only).
0088+  0000             ;*********************************************************************************************************************
0089+  0000             #DEFINE	jsrl(add)						.dw ((((add)&$7fff)>>1)|$a000)
0090+  0000             
0091+  0000             ;*********************************************************************************************************************
0092+  0000             ;* Vector Stat Macro: Applies these properties all vectors forthcoming. These are usually specific to
0093+  0000             ;*                    each vector game (this definition is for major havoc). The properties are as 
0094+  0000             ;*                    follows:
0095+  0000             ;*		Sparkle:   Creates a sparkle vectors by consistenly shifting the vector color data while the 
0096+  0000             ;*                 vector is being drawn.
0097+  0000             ;*		XFlip:     Mirrors the forthcoming vector along the X Axis. This is ;used to save Vector ROM space
0098+  0000             ;*                 on objects that can be drawn in either right or left hand views.
0099+  0000             ;*     	Page:      This 2-bit (4 pages) values defines which Vector ROM is enabled and viewable in the 
0100+  0000             ;*                 address space at $6000-$7fff.
0101+  0000             ;*     	Intensity: A 4-bit (16 levels) number to describe the brightness of the vector.
0102+  0000             ;*     	Color:     The 4-bit value of the color of the vector. The color definitions for major havoc are
0103+  0000             ;*                 defined below...
0104+  0000             ;*********************************************************************************************************************
0105+  0000             ;#DEFINE vstat2(i,c) 		\ ((i*16)+c)
0106+  0000             ;#DEFINE vstat1(s,x,p) 		\ ($60|((s*8)+(x*4)+(p)))
0107+  0000             #DEFINE	vstat(sp,xf,pg,int,clr)	\ .db ((int*16)+clr), ($60|(((sp*8)&8)+((xf*4)&4)+(pg&3)))
0108+  0000             
0109+  0000             ;*********************************************************************************************************************
0110+  0000             ;* Vector Scale Macro: Defines the binary and linear scaling factors for the vector. There is also an 
0111+  0000             ;*                    additional byte value that defines a Y-Window boundary. This boundary when non-zero
0112+  0000             ;*                    causes an invisible horizontal line to be defined at the value passed. Any vector
0113+  0000             ;*                    drawn while this line is defined, will be cropped at this line. This is most visible
0114+  0000             ;*                    in the gameplay of major havoc during the maze section  as all the maze walls the 
0115+  0000             ;*                    the player ship are cropped at this line. Note: This definition does not actually draw
0116+  0000             ;*                    the seperating while line, the programmer must do that in addition.
0117+  0000             ;*********************************************************************************************************************
0118+  0000             #DEFINE	vscal(ywindow,b_scale,l_scale)		.db (l_scale),($70|(ywindow*8)|b_scale))
0119+  0000             
0120+  0000             ;*********************************************************************************************************************
0121+  0000             ;* Return From Subroutine: Pulls the last address off the stack and returns to that address+2.			
0122+  0000             ;*********************************************************************************************************************
0123+  0000             #DEFINE	rtsl			.db $00,$C0
0124+  0000             
0125+  0000             ;*********************************************************************************************************************
0126+  0000             ;* Jump Absolute: Similar to Jump Subroutine but does not push the current address location onto the stack.
0127+  0000             ;*********************************************************************************************************************
0128+  0000             #DEFINE	jmpl(add)		.dw ((((add)&$7fff)>>1)|$e000)
0129+  0000             
0130+  0000             ;*********************************************************************************************************************
0131+  0000             ;* Vector Macro: Encodes the actual X,Y size of the vector. Z defines whether the vector is on or off
0132+  0000             ;*              The vector hardware supports two vector instructions but we use this one macro to
0133+  0000             ;*              draw any lines. The macro looks at the properties of the line to draw and decides if
0134+  0000             ;*              it can use the short vector instruction to save space (2 bytes instead of 4). The 
0135+  0000             ;*              limitations of using the short vector notation is that the lenghts must be divisible
0136+  0000             ;*              by two and must be under 32 long in each direction. This limitation is because of the
0137+  0000             ;*              way the vector data is compressed (=/2>>1) 		
0138+  0000             ;*********************************************************************************************************************	
0139+  0000             
0140+  0000             hidden      = 0
0141+  0000             visible     = 1
0142+  0000             #DEFINE vctrsx(sxlength,svctrvis)           \ .db (((sxlength>>1)&$1f)+(svctrvis<<5))
0143+  0000             #DEFINE vctrsy(sylength)                    \ .db (((sylength>>1)&$1f)|$40)
0144+  0000             #DEFINE vctrlx(lxlength,lvctrvis)           \ .dw ((lxlength&$1fff)+(lvctrvis<<13))
0145+  0000             #DEFINE vctrly(lylength)                    \ .dw (lylength&$1fff)
0146+  0000             
0147+  0000             #DEFINE	vctr(xlength,ylength,vctrvis)	    \#if ((xlength&1>0)|(ylength&1>0)|(xlength>=32d)|(ylength>=32d)|(xlength<=-32)|(ylength<=-32))   
0148+  0000             #DEFCONT			                        \ vctrly(ylength)
0149+  0000             #DEFCONT                                    \ vctrlx(xlength,vctrvis)
0150+  0000             #DEFCONT			                        \#else
0151+  0000             #DEFCONT			                        \ vctrsx(xlength,vctrvis)
0152+  0000             #DEFCONT                                    \ vctrsy(ylength)
0153+  0000             #DEFCONT			                        \#endif
0154+  0000             
0155+  0000             #DEFINE	vctrl(xlength,ylength,vctrvis)		  vctrly(ylength)  
0156+  0000             #DEFCONT									\ vctrlx(xlength,vctrvis) 
0157+  0000             
0158+  0000             #DEFINE	vctrs(lxlength,lylength,lvctrvis)	 vctrsy(lylength) 
0159+  0000             #DEFCONT									\ vctrsx(lxlength,lvctrvis)
0160+  0000             
0161+  0000             ;FOR SINGLE BYTE VECTORS
0162+  0000             #DEFINE VGADD_VCTRS(xlength,ylength,vctrvis)\#if ((xlength > 127)|(xlength < -128)|(ylength > 127)|(ylength < -128))
0163+  0000             #DEFCONT									\ .error "Vector length greater than byte value, use VGADD_VCTRL instead."
0164+  0000             #DEFCONT									\#else
0165+  0000             #DEFCONT										\ lda #(ylength)
0166+  0000             #DEFCONT										\#if (ylength)==(xlength)
0167+  0000             #DEFCONT										\ tax
0168+  0000             #DEFCONT										\#else
0169+  0000             #DEFCONT                                    	\ ldx #(xlength) 
0170+  0000             #DEFCONT										\#endif
0171+  0000             #DEFCONT										\#if (vctrvis>0)
0172+  0000             #DEFCONT										\ ldy #(vctrvis)
0173+  0000             #DEFCONT                                    	\ jsr vgvtr
0174+  0000             #DEFCONT										\#else
0175+  0000             #DEFCONT                                    	\ jsr vgvtr5
0176+  0000             #DEFCONT										\#endif
0177+  0000             #DEFCONT									\#endif
0178+  0000             
0179+  0000             ;FOR WORD VECTORS
0180+  0000             #DEFINE VGADD_VCTRL(xlength,ylength,vctrvis)\ lda #(ylength&$ff) 
0181+  0000             #DEFCONT                                    \ ldx #($1f&(ylength>>8)) 
0182+  0000             #DEFCONT                                    \ jsr vgadd2
0183+  0000             #DEFCONT                                    \ lda #(xlength&$ff) 
0184+  0000             #DEFCONT                                    \ ldx #$FF&(($1f&(ubyte(xlength)))+(vctrvis<<5))
0185+  0000             #DEFCONT                                    \ jsr vgadd2
0186+  0000             
0187+  0000             
0188+  0000             #DEFINE VGADD_JSR(jsrroutine)               \ laljsr(jsrroutine)
0189+  0000             #DEFCONT                                    \ lxhjsr(jsrroutine)
0190+  0000             #DEFCONT                                    \ jsr vgadd2
0191+  0000             
0192+  0000             ;********************************************************************
0193+  0000             ; Add Stat Instruction to VGRAM Pointer Location
0194+  0000             ; NOTE: the Vector Page can use *either* the full page code ($6X) or
0195+  0000             ;       just the raw page number, the top bytes are discarded.
0196+  0000             ;********************************************************************
0197+  0000             ; sp - Sparkle Control - 1 bit
0198+  0000             ; xf - X Flip Flag - 1 bit
0199+  0000             ; pg - Vector Page - 2 bits
0200+  0000             ; int- Vector Intensity - 4 bits
0201+  0000             ; clr- Vector Color - 4 bits
0202+  0000             ;********************************************************************
0203+  0000             #DEFINE VGADD_STAT(sp,xf,pg,int,clr)		\ lda #(int<<4)+(clr)
0204+  0000             #DEFCONT 									\ ldx #($60|((((sp&1)*8)&8)+(((xf&1)*4)&4)+(pg&3)))
0205+  0000             #DEFCONT									\ jsr vgadd2
0206+  0000             
0207+  0000             ;********************************************************************
0208+  0000             ; Add Scale Instruction to VGRAM Pointer Location
0209+  0000             ;********************************************************************
0210+  0000             #DEFINE VGADD_SCALE(ywindow,b_scale,l_scale)	\ lda #(l_scale)
0211+  0000             #DEFCONT 										\ ldx #($70|(ywindow*8)|b_scale))
0212+  0000             #DEFCONT										\ jsr vgadd2
0002   0000             #include "macros.ah"
0001+  0000             ;******************************************************************************
0002+  0000             	.title 	"Macro Definitions"
0003+  0000             	.sbttl 	"Global Macros"
0004+  0000             ;******************************************************************************
0005+  0000             
0006+  0000             #DEFINE orgchk(addr,curaddr)	\ #IF $ > (addr)
0007+  0000             #DEFCONT						\	.error "ORG definition (?0) is LOWER than the current address(?1). Check listing for overlap."
0008+  0000             #DEFCONT						\ #ENDIF
0009+  0000             #DEFCONT						\ .org addr
0010+  0000             
0011+  0000             ;*********************************************************************************************************************
0012+  0000             ;* Vector Call Wrappers for brevity
0013+  0000             ;*********************************************************************************************************************
0014+  0000             ; Push a JSRL onto the VGLIST and tidy
0015+  0000             #DEFINE vgadd_jsrl(obj)	\ laljsr(obj) 
0016+  0000             #DEFCONT				\ lxhjsr(obj)
0017+  0000             #DEFCONT				\ jsr vgadd2
0018+  0000             
0019+  0000             ;* Push some STAT data all immediate onto the VGLIST and tidy
0020+  0000             #DEFINE vgadd_stat(sp,xf,pg,int,clr)	\ lda # ((int*16)+clr)
0021+  0000             #DEFCONT								\ ldx # ($60|((sp*8)+(xf*4)+(pg)))
0022+  0000             #DEFCONT								\ jsr vgadd2
0023+  0000             
0024+  0000             ;* Push SCALE data
0025+  0000             #DEFINE	vgadd_scale(ywindow,b_scale,l_scale)	\ lda # (l_scale)
0026+  0000             #DEFCONT										\ ldx # ($70|(ywindow*8)|b_scale))
0027+  0000             #DEFCONT										\ jsr vgadd2
0028+  0000             
0029+  0000             ;* Draw a character by byte index
0030+  0000             #DEFINE JSR_VGCHAR(charidx)  	\ ldx vgmsga+(charidx*2)+1
0031+  0000             #DEFCONT						\ lda vgmsga+(charidx*2)
0032+  0000             #DEFCONT						\ jsr vgadd2          ;Add JSRL to this char
0033+  0000             
0034+  0000             ;* Draw a character which is in Y
0035+  0000             #DEFINE JSR_VGCHARY()  			\ ldx vgmsga+1,Y
0036+  0000             #DEFCONT						\ lda vgmsga,Y
0037+  0000             #DEFCONT						\ jsr vgadd2          ;Add JSRL to this char
0038+  0000             
0039+  0000             #DEFINE	lbyte(add)	(add&$ff)
0040+  0000             #DEFINE	ubyte(add)	((add&$ff00)/$100)0003   0000             #include "logic.ah"
0001+  0000             ;***********************************************
0002+  0000             ;* 6505 Style Logical Instruction Macros       *
0003+  0000             ;*                                             *
0004+  0000             ;***********************************************
0005+  0000             .module logic
0006+  0000             
0007+  0000             var1_		.equ	$00
0008+  0000             var2_		.equ	$00
0009+  0000             var3_		.equ	$00
0010+  0000             var4_		.equ	$00
0011+  0000             
0012+  0000             #define     FLAG_IF    	0
0013+  0000             #define     FLAG_ELSE 	1
0014+  0000             #define		FLAG_BEGIN 	2
0015+  0000             #define 	FLAG_IF_FAR	4
0016+  0000             
0017+  0000             ;*******************************************************************
0018+  0000             ;* Locate: Pushes two Words                                        *
0019+  0000             ;*                                                                 *
0020+  0000             ;*            Word 1 - address of branch location                  *
0021+  0000             ;*            Word 2 - Type of Operation                           *
0022+  0000             ;*                     0 - Standard ENDIF                          *
0023+  0000             ;*                     1 - ELSE or Logical ELSE                    *
0024+  0000             ;*                     2 - Loop                                    *
0025+  0000             ;*******************************************************************
0026+  0000             #define	logic_loc(type)	     \ .push  *, type
0027+  0000             
0028+  0000             ;*******************************************************************
0029+  0000             ;* Ifxx: These are the standard 'if' statements, they will always  *
0030+  0000             ;*       be of type 0.                                             *
0031+  0000             ;*******************************************************************
0032+  0000             #define	logic_ifxx(x)	     logic_loc(FLAG_IF) \ x  * 
0033+  0000             ;*******************************************************************
0034+  0000             ;* FAR Version will put a JMP to address in the middle when ended
0035+  0000             ;*******************************************************************
0036+  0000             #define	logic_ifxx_(x)	     logic_loc((FLAG_IF_FAR)) \ .db x,$03,$EA,$EA,$EA
0037+  0000             
0038+  0000             ;*******************************************************************
0039+  0000             ;* Begin: The start marker for logical loops, must terminate with  *
0040+  0000             ;*        an 'xxend' statement.                                    *
0041+  0000             ;******************************************************************* 
0042+  0000             #define     begin		     logic_loc(FLAG_BEGIN)
0043+  0000             
0044+  0000             ;*******************************************************************
0045+  0000             ;* Logic End: This is the end macro for the 'begin' statement. It  *
0046+  0000             ;*            pulls the pc location of the beginning of the loop   *
0047+  0000             ;*            and verifies that the 'type' is correct.             *
0048+  0000             ;*******************************************************************
0049+  0000             #define logic_loopend(x,y)	\ .pop var1_, var2_
0050+  0000             #defcont				\#if (var1_ & FLAG_BEGIN)
0051+  0000             #defcont					\#if ((var2_-*-2+127) <= 0) 
0052+  0000             #defcont						\ y	*+5
0053+  0000             #defcont						\ jmp	var2_
0054+  0000             #defcont					\#else
0055+  0000             #defcont						\ x	var2_
0056+  0000             #defcont					\#endif
0057+  0000             #defcont				\#else
0058+  0000             #defcont					\ .error "Inappropriate End for BEGIN Loop."
0059+  0000             #defcont				\#endif
0060+  0000             
0061+  0000             ;*******************************************************************
0062+  0000             ;* Logic Find: Used for ENDIF statement. Will find the pc for the  *
0063+  0000             ;*             previous IF (or ELSE) and update the branch or jump *
0064+  0000             ;*             at that address to point to the current address.    *
0065+  0000             ;*                                                                 *
0066+  0000             ;*  This will also look at the FLAG_FAR to determine more structure*
0067+  0000             ;*******************************************************************
0068+  0000             #define logic_end \var1_ .set *
0069+  0000             #defcont		\ .pop var3_, var4_
0070+  0000             #defcont		\#if (var3_ & FLAG_BEGIN)==0 	
0071+  0000             #defcont			\#if (var3_ & FLAG_ELSE)==0	
0072+  0000             #defcont                \#if (var3_ & FLAG_IF_FAR)==0	 
0073+  0000             #defcont  					\var2_ .set var1_-var4_-2
0074+  0000             #defcont					\#if var2_+127 < 0
0075+  0000             #defcont						\ .error "Branch Range < -127, use far logic"
0076+  0000             #defcont					\#else
0077+  0000             #defcont						\#if var2_-128 > 0
0078+  0000             #defcont							\ .error "Branch Range > 128, use far logic"
0079+  0000             #defcont						\#else
0080+  0000             #defcont   	 						\ .org var4_+1
0081+  0000             #defcont							\ .byte var2_
0082+  0000             #defcont						\#endif
0083+  0000             #defcont					\#endif
0084+  0000             #defcont				\#else
0085+  0000             #defcont					\ .org var4_+2
0086+  0000             #defcont					\ jmp var1_
0087+  0000             #defcont				\#endif
0088+  0000             #defcont			\#else	
0089+  0000             #defcont    			\ .org  var4_-2	
0090+  0000             #defcont				\ .word var1_
0091+  0000             #defcont			\#endif
0092+  0000             #defcont			\ .org	var1_
0093+  0000             #defcont		\#else
0094+  0000             #defcont			\ .error "Wrong Endtype for IF block"
0095+  0000             #defcont		\#endif
0096+  0000             
0097+  0000             ;*******************************************************************
0098+  0000             ;* Logic Else: Can act as a standard else or a complex else        *
0099+  0000             ;*             (ie. with additional logic as defined below). The   *
0100+  0000             ;*             ELSE block will resove how to terminate the current *
0101+  0000             ;*             code and then set the owning IF statement's data    *
0102+  0000             ;*             byte.                                               *
0103+  0000             ;*******************************************************************
0104+  0000             #define	logic_else(x,y)	\var1_ .set $
0105+  0000             #defcont		\ .pop var3_, var4_
0106+  0000             #defcont		\#if (var3_ & FLAG_BEGIN)==0
0107+  0000             #defcont			\#if (var3_ & FLAG_ELSE)==0
0108+  0000             #defcont				\ .org var4_+1
0109+  0000             #defcont	      		\#if x==0
0110+  0000             #defcont  					\var2_ .set var1_-var4_-2+3
0111+  0000             #defcont					\#if var2_+127 < 0
0112+  0000             #defcont						\ .error "Branch Range < -127, use far logic"
0113+  0000             #defcont					\#else
0114+  0000             #defcont						\#if var2_-128 > 0
0115+  0000             #defcont							\ .error "Branch Range > 128, use far logic"
0116+  0000             #defcont						\#else
0117+  0000             #defcont					        \ .byte var1_-var4_-2+3
0118+  0000             #defcont					        \ .org var1_
0119+  0000             #defcont					        \.push $+3, 1
0120+  0000             #defcont					        \ jmp $
0121+  0000             #defcont						\#endif
0122+  0000             #defcont					\#endif
0123+  0000             #defcont				\#else
0124+  0000             #defcont					\ .byte var1_-var4_-2+2
0125+  0000             #defcont					\ .org var1_
0126+  0000             #defcont					\.push $, 0
0127+  0000             #defcont					\ y $		
0128+  0000             #defcont				\#endif
0129+  0000             #defcont			\#else
0130+  0000             #defcont				\.error "Duplicate ELSE Statement"
0131+  0000             #defcont			\#endif
0132+  0000             #defcont		\#else
0133+  0000             #defcont			\ .error "Misplaced Else"
0134+  0000             #defcont		\#endif
0135+  0000             
0136+  0000             
0137+  0000             ;*******************************************************************
0138+  0000             ;* Defines how to use the various logic macros defined above.      *
0139+  0000             ;* NOTICE: How these inverse, ifeq becomes BNE
0140+  0000             ;*******************************************************************
0141+  0000             #define	ifeq	logic_ifxx(BNE)		
0142+  0000             #define	ifne	logic_ifxx(BEQ)
0143+  0000             #define	ifpl	logic_ifxx(BMI)
0144+  0000             #define	ifmi	logic_ifxx(BPL)
0145+  0000             #define	ifcs	logic_ifxx(BCC)
0146+  0000             #define	ifcc	logic_ifxx(BCS)
0147+  0000             #define iflt	logic_ifxx(BCS)
0148+  0000             #define	ifge	logic_ifxx(BCC)
0149+  0000             #define ifvc	logic_ifxx(BVS)
0150+  0000             #define ifvs	logic_ifxx(BVC)
0151+  0000             
0152+  0000             #define	else  	logic_else(0,0)
0153+  0000             #define	else_eq	logic_else(1,BEQ)
0154+  0000             #define	else_ne	logic_else(1,BNE)
0155+  0000             #define	else_pl	logic_else(1,BPL)
0156+  0000             #define	else_mi	logic_else(1,BMI)
0157+  0000             #define	else_cc	logic_else(1,BCC)
0158+  0000             #define	else_cs	logic_else(1,BCS)
0159+  0000             
0160+  0000             #define endif		logic_end
0161+  0000             
0162+  0000             #define	eqend	logic_loopend(BNE,BEQ)		
0163+  0000             #define	neend	logic_loopend(BEQ,BNE)		
0164+  0000             #define	plend	logic_loopend(BMI,BPL)
0165+  0000             #define	miend	logic_loopend(BPL,BMI)
0166+  0000             #define	csend	logic_loopend(BCC,BCS)
0167+  0000             #define	gtend	logic_loopend(BCC,BCS)
0168+  0000             #define	ccend	logic_loopend(BCS,BCC)
0169+  0000             #define	leend	logic_loopend(BCS,BCC)
0170+  0000             #define	vcend	logic_loopend(BVS,BVC)
0171+  0000             #define	vsend	logic_loopend(BVC,BVS)
0172+  0000             #define	doloop	logic_loopend(JMP,0)
0173+  0000             
0174+  0000             ;*******************************************************************
0175+  0000             ;* FAR LOGIC, will always assume a JMP, this is longer bytewise
0176+  0000             ;* but is required if the branch is farther then +/127 away.
0177+  0000             ;* NOTICE: These don't invert the call to the actual branch.
0178+  0000             ;*******************************************************************
0179+  0000             #define	ifeq_	logic_ifxx_($F0)
0180+  0000             #define	ifne_	logic_ifxx_($D0)
0181+  0000             #define	ifpl_	logic_ifxx_($10)
0182+  0000             #define	ifmi_	logic_ifxx_($30)
0183+  0000             #define	ifcs_	logic_ifxx_($B0)
0184+  0000             #define	ifcc_	logic_ifxx_($90)
0185+  0000             #define ifvc_	logic_ifxx_($50)
0186+  0000             #define ifvs_	logic_ifxx_($70)
0187+  0000             #define iflt_	logic_ifxx_($90)
0188+  0000             #define	ifge_	logic_ifxx_($B0)
0004   0000             #include "havoc.ah"
0001+  0000             .module globals
0002+  0000             ;******************************************************************************
0003+  0000             ;* Version Number for release
0004+  0000             ;* This will tag each ROM with a version number for identification purposes
0005+  0000             ;******************************************************************************
0006+  0000             MAJOR_VERSION = $1
0007+  0000             MINOR_VERSION = $00
0008+  0000             
0009+  0000             ;******************************************************************************
0010+  0000             ; LANGUAGE - we can build multiple languages now!
0011+  0000             ; NOTES: These are single builds, so a ROMset is 
0012+  0000             ;        PRE-compiled for a specific language.
0013+  0000             ;  
0014+  0000             ; ENGLISH = 0
0015+  0000             ; GERMAN  = 1	Contributed by Thomas Sontowski
0016+  0000             ; FRENCH  = 2	Contributed by Jerome Vince
0017+  0000             ;******************************************************************************
0018+  0000             LANGUAGE = 0
0019+  0000             
0020+  0000             ;******************************************************************************
0021+  0000             ;* TOURNAMENT EDITION flag does alternate build for Jerky's maze changes
0022+  0000             ;******************************************************************************
0023+  0000             TOURNAMENT_EDITION = 0
0024+  0000             
0025+  0000             ;******************************************************************************
0026+  0000             ;* DEBUGGING DEFINES, Take these out for final builds
0027+  0000             ;******************************************************************************
0028+  0000             DEBUG = 0
0029+  0000             
0030+  0000             ;******************************************************************************
0031+  0000             ;* SPEECH - Which format should speech be compiled with
0032+  0000             ;* 
0033+  0000             ;*	ADPCM = 0
0034+  0000             ;*  TILPC = 1
0035+  0000             ;******************************************************************************
0036+  0000             SPEECH = 0
0037+  0000             
0038+  0000             ;******************************************************************************
0039+  0000             ;* LEVEL EDITOR BUILD
0040+  0000             ;******************************************************************************
0041+  0000             ;This will build ROM's targeted for the Major Havoc Level Editor
0042+  0000             ;It takes out specific parts of the game to streamline playing 
0043+  0000             ;a single level for play testing.
0044+  0000             LEVEL_EDITOR = 0
0045+  0000             
0046+  0000             ;******************************************************************************
0047+  0000             ;* Display the Atari Copyright Message during attract mode
0048+  0000             ;******************************************************************************
0049+  0000             DISPLAY_COPYRIGHT = 0
0050+  0000             
0051+  0000             ;******************************************************************************
0052+  0000             ;* Override the number of Rex's to start the game.
0053+  0000             ;******************************************************************************
0054+  0000             NUMLIVES = 9d
0055+  0000             
0056+  0000             ;******************************************************************************
0057+  0000             ;* Sets Beginning Level - This also affects Select-a-Level
0058+  0000             ;******************************************************************************
0059+  0000             ;* Normal start is 1d
0060+  0000             ;* Star Castle is is 21d
0061+  0000             STARTLEVEL = 1
0062+  0000             
0063+  0000             ;******************************************************************************
0064+  0000             ;* Disable Demo mode - toggle this to keep the dips from setting this to enabled;
0065+  0000             ;******************************************************************************
0066+  0000             ;DISABLE_DEMO = 0
0067+  0000             
0068+  0000             ;******************************************************************************
0069+  0000             ;* Disable HCOUNT VGResets - this was part of the original code but not sure 
0070+  0000             ;* it is needed for now. Will disable but this will make it
0071+  0000             ;* super easy to re-enable if needed
0072+  0000             ;* DEFAULT is 0
0073+  0000             ;******************************************************************************
0074+  0000             DISABLE_HCOUNT = 0
0075+  0000             
0076+  0000             ;******************************************************************************
0077+  0000             ;* Normally the game has faster than normal transitions between major 
0078+  0000             ;* scenes, I think this was done to make the game time shorter, so Im
0079+  0000             ;* going to take it out but this makes it easy to turn back on.
0080+  0000             ;* DEFAULT is 0
0081+  0000             ;******************************************************************************
0082+  0000             DISABLE_FASTTRANSITIONS = 1
0083+  0000             
0084+  0000             ;******************************************************************************
0085+  0000             ;* WASTE is a step in the IRQ that will keep the VG busy if the main loop has
0086+  0000             ;* not restarted the VG in a certain amount of time.
0087+  0000             ;* DEFAULT is 1
0088+  0000             ;******************************************************************************
0089+  0000             ENABLE_WASTE = 0
0090+  0000             
0091+  0000             
0092+  0000             ;Flag to do the O2 animations, Owen didn't like this so it is turned off
0093+  0000             ANIMATE_OXYGEN = 1
0094+  0000             
0095+  0000             ;Show the yellow 'levitations' under Max robot
0096+  0000             MAX_LEVITATIONS = 1
0097+  0000             
0098+  0000             ;If this is level editor, override STARTLEVEL to be 1
0099+  0000~            #IF LEVEL_EDITOR != 0
0100+  0000~            STARTLEVEL .set 1d
0101+  0000~            NUMLIVES   .set 9d
0102+  0000             #ENDIF
0103+  0000             
0104+  0000             ;Handy flag to force an animation on each tact, never allow on 
0105+  0000             ;Non-Debug builds tho
0106+  0000             FORCE_TESSERACT_ANIMATION	= 0
0107+  0000             
0108+  0000             #IF DEBUG = 0
0109+  0000             FORCE_TESSERACT_ANIMATION .set 0
0110+  0000             #ENDIF
0111+  0000             
0112+  0000             ;Force hide the framecounter even if in debug mode 
0113+  0000             ;This is handy for taking screenshots in debug if you don't want it showing
0114+  0000             FORCE_HIDE_FRAMECOUNT = 1
0115+  0000             
0116+  0000             ;Another handly flag to force the bonus countup after each level
0117+  0000             ;never allow on non-debug builds
0118+  0000             FORCE_HOMEWORLD_BONUS	= 0
0119+  0000             
0120+  0000             ;Force showing the designer page
0121+  0000             FORCE_DESIGNERS = 0
0122+  0000             
0123+  0000             #IF DEBUG = 0
0124+  0000             FORCE_HOMEWORLD_BONUS .set 0
0125+  0000             FORCE_DESIGNERS .set 0
0126+  0000             #ENDIF
0127+  0000             
0128+  0000             ;************************************
0129+  0000             ;* ROM Identifiers are here so they
0130+  0000             ;* are all in one place. These also
0131+  0000             ;* match CSUM key values for ALPHA.
0132+  0000             ;************************************
0133+  0000             IDENTIFIER_AL = 00d
0134+  0000             IDENTIFIER_AH = 01d
0135+  0000             IDENTIFIER_P0 = 02d
0136+  0000             IDENTIFIER_P1 = 03d
0137+  0000             IDENTIFIER_P2 = 04d
0138+  0000             IDENTIFIER_P3 = 05d
0139+  0000             IDENTIFIER_P4 = 06d
0140+  0000             IDENTIFIER_P5 = 07d
0141+  0000             IDENTIFIER_P6 = 08d
0142+  0000             IDENTIFIER_P7 = 09d
0143+  0000             IDENTIFIER_VR = 10d
0144+  0000             IDENTIFIER_V0 = 11d
0145+  0000             IDENTIFIER_V1 = 12d
0146+  0000             IDENTIFIER_V2 = 13d
0147+  0000             IDENTIFIER_V3 = 14d
0148+  0000             IDENTIFIER_GG = 15d
0149+  0000             IDENTIFIER_BL = 16d
0150+  0000             IDENTIFIER_BH = 17d
0151+  0000             
0152+  0000             IDCOUNT	.equ IDENTIFIER_BH + 1 - IDENTIFIER_AL
0005   0000             #include "a_def.ah"
0001+  0000             .module alpha
0002+  0000             
0003+  0000                 .sbttl  "Hardware Equates"
0004+  0000             
0005+  0000             ;***********************************************************
0006+  0000             ;*   Hardware Equates -- Switches and Inputs               *
0007+  0000             ;***********************************************************
0008+  0000             
0009+  0000             portrd      =   $1000       ;Gamma Port Read
0010+  0000             inputs      =   $1200       ;INPUTS
0011+  0000                                         ;Player 1 = 0
0012+  0000                                         ;(D0) VG Halt
0013+  0000                                         ;(D1) 2.4 KHz Signal
0014+  0000                                         ;(D2) Port Status: XMIT Gamma (if -, input is full)
0015+  0000                                         ;(D3) Port Status: RCVD Gamma (if -, port is empty)
0016+  0000                                         ;(D4) Diagnostic Step Switch (and Aux Coin)
0017+  0000                                         ;(D5) Coins
0018+  0000                                         ;Player 1 = 1
0019+  0000                                         ;(D6) Two Coin Minimum
0020+  0000                                         ;(D7) Self Test (0=ON) When Player select set to 1
0021+  0000             
0022+  0000             ;***********************************************************
0023+  0000             ;*   Hardware Equates -- Outputs                           
0024+  0000             ;***********************************************************
0025+  0000             colram      =   $1400       ;16 locations, ColorRAM
0026+  0000             outputs     =   $1600       ;Outputs to other stuff
0027+  0000                                         ;(D7) Invert Y - These are pulled HIGH on PCB, solder pads can be bridged to allow CPU control
0028+  0000                                         ;(D6) Invert X - These are pulled HIGH on PCB, solder pads can be bridged to allow CPU control
0029+  0000                                         ;(D5) Player Select - Input Switches Mux
0030+  0000                                         ;(D3) Reset Gamma (0=run)
0031+  0000                                         ;(D2) Reset Beta  (0=run)
0032+  0000                                         ;(D1) Not Used
0033+  0000                                         ;(D0) Roller Light
0034+  0000                                         
0035+  0000             vggo        =   $1640       ;Vector Generator Go!
0036+  0000             watchdog    =   $1680       ;Watchdog
0037+  0000             vgreset     =   $16c0       ;Vector Generator Reset
0038+  0000             intack      =   $1700       ;IRQ Ackknowledge
0039+  0000             rompg       =   $1740       ;(Bit 0) ROM Page Select
0040+  0000             rampg       =   $1780       ;(Bit 0) RAM Page Select
0041+  0000             portwr      =   $17c0       ;Gamma Port Write
0042+  0000             
0043+  0000             ;***********************************************************
0044+  0000             ;*   Hardware Equates -- Memory Address Base                  *
0045+  0000             ;***********************************************************
0046+  0000             comram      =   $1800       	;Alpha/Beta Communication RAM
0047+  0000             auxpgm      =   $2000       	;Paged ROM Memory (8k)
0048+  0000             vecram      =   $4000       	;VG Ram Start (4k)
0049+  0000             vecramb2	=   vecram+$800		;Upper buffer start
0050+  0000             vecrom      =   $5000       	;VG ROM Start (8k Max)
0051+  0000             vecromov	=   vecrom+$1000	;Paged ROM starts here
0052+  0000             program     =   $8000       	;Program Memory Start
0053+  0000             program2	=   program+$4000	;Second ROM
0054+  0000             
0055+  0000             crsbuf      =   vecram+$030e    ;Buffer for Radar Screen Crosshairs
0056+  0000             mapbuf      =   vecram+$0400    ;A good place for the map
0057+  0000             
0058+  0000             ;rsbuf      =   vecram+$0b0e    ;Symmetrical placement on other page as well
0059+  0000             accbuf      =   vecram+$0c00    ;Accordian buffer for de hand
0060+  0000                                             ;Must start on even hundred boundary
0061+  0000                                             ;Uses $100 bytes
0062+  0000             trnbuf      =   vecram+$0d00    ;Buffer for Transporter sparkels
0063+  0000                                             ;Must be on $100 boundary
0064+  0000                                             ;Uses $80 bytes
0065+  0000             scobuf      =   vecram+$0e00    ;A good place for the scores
0066+  0000             scobufs		=   scobuf + $08	;Data starts here 
0067+  0000             scobuf2     =   vecram+$0e30    ;Player 2 Score Buffers
0068+  0000             scobuf2s    =	scobuf2+ $08	;Data starts here
0069+  0000             retbuf      =   vecram+$0e60    ;Reactor Blow Time Buffer
0070+  0000             retbufs		=   retbuf + $0a	;Data Starts here
0071+  0000             oxybuf      =   vecram+$0e90    ;Oxygen Counter Buffer
0072+  0000             
0073+  0000~            #IF (DEBUG != 0) | (LEVEL_EDITOR != 0)
0074+  0000~            dbgbuf   	= 	vecram+$0ed0	;Buffer for rendering debug info to screen
0075+  0000             #ENDIF
0076+  0000             
0077+  0000             sparkb      =   vecram+$0f00    ;Buffer for Sparkles
0078+  0000             
0079+  0000             
0080+  0000                 .sbttl  "Symbol Declarations"
0081+  0000             ;***********************************************************
0082+  0000             ;*   Symbol Declarations                                   *
0083+  0000             ;***********************************************************
0084+  0000             ;Bits used in Inputs
0085+  0000             i_haltbit       =   $01     ;Halt Bit
0086+  0000             i_24khz         =   $02
0087+  0000             i_xmigama       =   $04     ;Mask for Gamma Xmit    
0088+  0000             i_rcvgama       =   $08     ;Mask for Gamma Recieve
0089+  0000             i_lmbit         =   $10     ;???
0090+  0000             i_auxcoin       =   $20     ;Mask for Aux Coin
0091+  0000             i_cocktail      =   $40    	;Cocktail bit, used to be TWO Coin Minimum
0092+  0000             i_slftstbit     =   $80     ;Mask for Self Test
0093+  0000             
0094+  0000              ;Bits used in Outputs
0095+  0000             ;plrslb     =   $20     ;Player Select Bit
0096+  0000             ;xinvert        =   $40     ;(D6=1) X Invert 
0097+  0000             ;yinvert        =   $80     ;(D7=1) Y Invert
0098+  0000             
0099+  0000             ;Bitflags for outputs
0100+  0000             o_inverty   = $80
0101+  0000             o_invertx   = $40
0102+  0000             o_swtchmux  = $20       
0103+  0000             o_resetg    = $08
0104+  0000             o_resetb    = $04
0105+  0000             o_lighton   = $01
0106+  0000             
0107+  0000              ;Bits used in STAT instruction
0108+  0000             xflip       =   $04     ;ORA into STAT for XFlip Object
0109+  0000             sparkle     =   $08     ;ORA into STAT for Sparkle ON
0110+  0000             
0111+  0000             ;***********************************
0112+  0000             ;* Color Indexes of Color RAM      
0113+  0000             ;*
0114+  0000             ;* Use these for Vector Parameters
0115+  0000             ;***********************************
0116+  0000             colblack    =   $0
0117+  0000             colblue     =   $1
0118+  0000             colgreen    =   $2
0119+  0000             colcyan     =   $3
0120+  0000             colred      =   $4
0121+  0000             colpurple   =   $5
0122+  0000             colyellow   =   $6
0123+  0000             colwhite    =   $7
0124+  0000             colwhiter   =   $8
0125+  0000             colpink     =   $9
0126+  0000             colorange   =   $A
0127+  0000             colred2     =   $B			;this used to be called colredr
0128+  0000             colflash     =  $C
0129+  0000             colcyanr    =   $D
0130+  0000             colbluer    =   $E
0131+  0000             colgreenr   =   $F
0132+  0000             
0133+  0000             ;Color Assignments
0134+  0000             oxycol      =   colgreen    ;Oxygen Counter Color
0135+  0000             mazcol      =   colgreen    ;Maze Color
0136+  0000             fsscol      =   colwhite    ;Final Space Station Maze Color
0137+  0000             spmzcol		=   colcyanr	;Hidden level Maze Color
0138+  0000             mancol      =   colcyan     ;Man's Color (Player 1)
0139+  0000             mancol2     =   colorange   ;Man's Color (Player 2)
0140+  0000             reacol      =   colpurple   ;Reactor Body Color
0141+  0000             whtlin      =   colwhite    ;White Lines
0142+  0000             fircol      =   colwhiter   ;Fireball Color
0143+  0000             rodcol      =   colorange   ;Reactor Rod Color
0144+  0000             re2col      =   colorange   ;Fire Ball in Reactor
0145+  0000             robcol      =   colbluer    ;Robot Body Color
0146+  0000             shtcol      =   colred2     ;Shot Color
0147+  0000             flacol      =   colflash    ;Flash Color
0148+  0000             
0149+  0000             ;*****************************************************************
0150+  0000             ;Color RAM: Value = What Color = Actual Bits
0151+  0000             ; Color drives are limited too Blue, Green and Red full on or off
0152+  0000             ; plus a 'weak-red' drive. Values here are active low.
0153+  0000             ;*****************************************************************
0154+  0000             ;                       RED  WRED GRN BLUE 
0155+  0000             whiter      =   $00		;ON  ON   ON  ON
0156+  0000             orange      =   $01		;ON  ON   ON  OFF
0157+  0000             pink        =   $02     ;ON	 ON   OFF ON 
0158+  0000             redr        =   $03     ;ON  ON   OFF OFF 
0159+  0000             white       =   $04     ;ON  OFF  ON  ON 
0160+  0000             yellow      =   $05		;ON  OFF  ON  OFF 
0161+  0000             purple      =   $06     ;ON  OFF  OFF ON 
0162+  0000             red2        =   $07		;ON  OFF  OFF OFF 
0163+  0000             cyanr       =   $08		;OFF ON   ON  ON 
0164+  0000             greenr      =   $09		;OFF ON   ON  OFF 
0165+  0000             bluer       =   $0a     ;OFF ON   OFF ON 
0166+  0000             red         =   $0b     ;OFF ON   OFF ON
0167+  0000             cyan        =   $0c		;OFF OFF  ON  ON 
0168+  0000             green       =   $0d		;OFF OFF  ON  OFF
0169+  0000             blue        =   $0e		;OFF OFF  OFF ON
0170+  0000             black       =   $0f		;OFF OFF  OFF OFF
0171+  0000             
0172+  0000             ;***********************************************************
0173+  0000             ;*   Program Equates                                       *
0174+  0000             ;***********************************************************
0175+  0000             ;ENUMS
0176+  0000             sphere      =   0       ;Spheres    - Wave 0
0177+  0000             fighter     =   1       ;Fighters   - Wave 1
0178+  0000             spacemaze   =   2       ;Spinners   - Wave 2
0179+  0000             spacefort   =   3       ;Space Fort - Wave 3
0180+  0000             
0181+  0000             nmsparks    =   6       ;Number of Sparkler points for each Fireball
0182+  0000             
0183+  0000             nmman       =   1       ;Number of Man
0184+  0000             nmreactor   =   1       ;Number of Reactors
0185+  0000             nmfire      =   16d     ;Number of Fireballs
0186+  0000             nmlsht      =   8       ;Number of Laser Cannon Shots
0187+  0000             nmcann      =   4       ;Number of Laser Cannons
0188+  0000             nmrob       =   10d      ;Number of Perkoid Robots
0189+  0000             nmshot      =   nmrob   ;1 Shot for each Robot
0190+  0000             nmmax       =   6       ;Number of Max Robots
0191+  0000             nmmotobj    =   nmman+nmreactor+nmfire+nmlsht+nmcann+nmrob+nmshot+nmmax
0192+  0000             nmrshp		= 	1		;Rex's ship on maze
0193+  0000             nmtoke		= 	1		;Number of Tokens
0194+  0000             nmtite      =   5       ;Number of Stalactites
0195+  0000             nmtran      =   8       ;Number of Transporters
0196+  0000             ntrans      =   8       ;Number of Transporter Sparkels
0197+  0000             nmlock      =   4       ;Number of Locks
0198+  0000             nmkeys      =   nmlock  ;Number of Keys
0199+  0000             nmstuf      =   5       ;Clock,Boots,Escape,Hand,Keypouch
0200+  0000             nmdisc      =   16      ;Number of Oxygen
0201+  0000             nmligh      =   7       ;Horizontal Force Fields
0202+  0000             nmfrfl      =   7       ;Vertical Force Fields
0203+  0000             nmtrpp      =   8       ;Number of Trip Points
0204+  0000             nmonew      =   4       ;Number of One Way Walls
0205+  0000             nmarow      =   10      ;Number of Help Arrows
0206+  0000             
0207+  0000             nmnew       =   nmtite+nmtran+nmlock+nmkeys+nmstuf
0208+  0000             nmspec      =   nmnew+nmdisc+nmligh+nmfrfl+nmtrpp+nmonew+nmarow
0209+  0000             nmobjs		=  	nmmotobj+nmrshp+nmtoke+nmspec
0210+  0000             
0211+  0000             nmsshots    =   8       ;Number of Space Ship Shots
0212+  0000             maxstr      =   20      ;Number of Stars
0213+  0000             nmspace     =   25      ;Number of Space Spaceships
0214+  0000             nmexp       =   12      ;Number of Pieces in Ship Explosion
0215+  0000             nmform      =   13      ;Number of Fighters in Space Formation
0216+  0000             
0217+  0000             ;**********************************************************************
0218+  0000             ;Offsets into OBJ tables
0219+  0000             ;**********************************************************************
0220+  0000             ; Index			Object
0221+  0000             ;**********************************************************************
0222+  0000             ; 0x00			Rex
0223+  0000             ; 0x01			Reactor
0224+  0000             ; 0x02-0x11		Pyroid/Fireball
0225+  0000             ; 0x12-0x19		Laser Cannon Shots
0226+  0000             ; 0x1a-0x1d		Laser Cannons
0227+  0000             ; 0x1e-0x27		Perkoids
0228+  0000             ; 0x28-0x31		Perkoid Shots
0229+  0000             ; 0x32-0x37		Max Robots
0230+  0000             ; 0x38			Ship on Maze
0231+  0000             ; 0x39			Token
0232+  0000             ; 0x3a-0x3e		Stalactites
0233+  0000             ; 0x3f-0x46		Transporters
0234+  0000             ; 0x47-0x4a		Locks
0235+  0000             ; 0x4b-0x4e		Keys
0236+  0000             ; 0x4f			Clock
0237+  0000             ; 0x50			Boots
0238+  0000             ; 0x51			Escape Pod
0239+  0000             ; 0x52			Hand
0240+  0000             ; 0x53			Key Pouch
0241+  0000             ; 0x54-0x63		Oxygen
0242+  0000             ; 0x64-0x6b		Lighning-H
0243+  0000             ; 0x6b-0x71		Lighning-V
0244+  0000             ; 0x72-0x79		Trip Pads
0245+  0000             ; 0x7a-0x7d		One Way
0246+  0000             ; 0x7e-0x8d		Arrows
0247+  0000             ;***********************************************************
0248+  0000             zman        =   0                   ;Maze/Man
0249+  0000             zreactor    =   zman+nmman          ;Reactor 
0250+  0000             zfire       =   zreactor+nmreactor  ;fireballs
0251+  0000             zlsht       =   zfire+nmfire        ;Laser shots
0252+  0000             zcann       =   zlsht+nmlsht        ;Laser Cannons
0253+  0000             zrobot      =   zcann+nmcann        ;Perkoid Robots 
0254+  0000             zshot       =   zrobot+nmrob        ;Perkoid Shots
0255+  0000             zmax        =   zshot+nmshot        ;Max Robots
0256+  0000             zspecial    =   zmax+nmmax          ;Rex's Ship on Maze
0257+  0000             ztoken		= 	zspecial+nmrshp
0258+  0000             ztop        =   ztoken+nmtoke  		;Top of Motion Objects - Objects after this only have a postion associated with them
0259+  0000             ztite       =   ztop                ;Stalactites
0260+  0000             ztran       =   ztite+nmtite        ;Transporter Booths
0261+  0000             zlock       =   ztran+nmtran        ;Locks
0262+  0000             zkeys       =   zlock+nmlock        ;And their Keys
0263+  0000             zstuf       =   zkeys+nmkeys        ;Misc Stuff
0264+  0000                                                 ;zstuf  	= slow down clock
0265+  0000                                                 ;zstuf+1    = magic jump boots
0266+  0000                                                 ;zstuf+2    = escape pod
0267+  0000                                                 ;zstuf+3    = de hand
